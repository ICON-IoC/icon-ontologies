  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008048">
    <obo:IAO_0000115 xml:lang="en">Data recorded by county.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">county unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008080">
    <obo:IAO_0000115 xml:lang="en">The kind of data, or the form it comes in. One list holds both, so a Data record and a tool's input or output are described in the same terms and a dataset can be matched to the tools that take it: Land cover or vegetation map and Raster describe both the Cropland Data Layer and an input InVEST takes.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/type"/>
    <iconbase:ICON_0000001>DataCite 4.5: resourceType</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008081">
    <obo:IAO_0000115 xml:lang="en">Individual sightings or detections of a species or feature, each with a place and a date, such as CNDDB occurrences or camera trap detections.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008080"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">observation records</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008082">
    <obo:IAO_0000115 xml:lang="en">Measurements taken by a protocol across sites or over time: counts, plots, catch, water samples.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008080"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">survey and monitoring data</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008083">
    <obo:IAO_0000115 xml:lang="en">Where a species lives or is known to occur, mapped as a range or distribution.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
