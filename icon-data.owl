    <iconbase:ICON_0000001>DataCite 4.5: date dateType Coverage</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: coverage/temporalCoverage/rangeOfDates/beginDate</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008202">
    <obo:IAO_0000115 xml:lang="en">The last year the data describes; blank while it is still being added to.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon-ioc/ICON_0008000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">coverage end</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#endDate"/>
    <iconbase:ICON_0000001>EML 2.2: coverage/temporalCoverage/rangeOfDates/endDate</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008203">
    <obo:IAO_0000115 xml:lang="en">Grid cell size, mapping unit or positional accuracy, written with its unit: 30 m for C-CAP, 4 km for gridMET. Converted to dcat:spatialResolutionInMeters on export when the unit is a length.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon-ioc/ICON_0008000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">spatial resolution</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#spatialResolutionInMeters"/>
    <iconbase:ICON_0000001>EML 2.2: spatialRaster/cellSizeXDirection</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: MD_Resolution/distance</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008204">
    <obo:IAO_0000115 xml:lang="en">The smallest social unit the data describes or can be broken down to, such as household or census tract.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon-ioc/ICON_0008000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">social resolution</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/data.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">Data resources at three levels (dataset, database, data repository): who creates, publishes, hosts, funds and uses them, what they cover in time, space and subject, and how they derive from and hold one another.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://publications.europa.eu/resource/authority/access-right"/>
    <dcterms:references rdf:resource="http://publications.europa.eu/resource/authority/frequency"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:references rdf:resource="http://purl.org/dc/terms/"/>
    <dcterms:references rdf:resource="http://www.w3.org/ns/dcat"/>
    <dcterms:references rdf:resource="http://www.w3.org/ns/prov-o"/>
    <dcterms:references rdf:resource="https://schema.org/"/>
    <dcterms:title xml:lang="en">ICON Data ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Reused: DCAT 3 (W3C Data Catalog Vocabulary), Dublin Core terms, EU frequency authority list. Built on: Dublin Core terms, Information Artifact Ontology, Ontology for Biomedical Investigations. Mapped to: DCAT 3 (W3C Data Catalog Vocabulary), Dublin Core terms, EU access-right authority list, PROV-O (W3C provenance), schema.org.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/infrastructure.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/mandates.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon-ioc/releases/2026-11-21/data.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
