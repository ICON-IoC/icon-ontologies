  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/ANNUAL">
    <obo:IAO_0000115 xml:lang="en">The event occurs once a year.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">annual</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/BIENNIAL">
    <obo:IAO_0000115 xml:lang="en">The event occurs every two years.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">biennial</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/CONT">
    <obo:IAO_0000115 xml:lang="en">The item is updated more frequent than daily.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">continuous</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/DAILY">
    <obo:IAO_0000115 xml:lang="en">The event occurs once a day.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">daily</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/IRREG">
    <obo:IAO_0000115 xml:lang="en">The event occurs at uneven intervals.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">irregular</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/MONTHLY">
    <obo:IAO_0000115 xml:lang="en">The event occurs once a month.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">monthly</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/NEVER">
    <obo:IAO_0000115 xml:lang="en">The item is never updated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">never</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/QUARTERLY">
    <obo:IAO_0000115 xml:lang="en">The event occurs every three months.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">quarterly</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/QUINQUENNIAL">
    <obo:IAO_0000115 xml:lang="en">The event occurs every five years.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">quinquennial</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/frequency/WEEKLY">
    <obo:IAO_0000115 xml:lang="en">The event occurs once a week.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">weekly</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
    <obo:IAO_0000115 xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">independent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
    <obo:IAO_0000115 xml:lang="en">b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
    <obo:IAO_0000115 xml:lang="en">An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">data entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
    <obo:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">information content entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000033">
    <obo:IAO_0000115 xml:lang="en">An information content entity whose concretizations indicate to their bearer how to realize them in a process.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">directive information entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>definition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0001000">
    <obo:IAO_0000115 xml:lang="en">A data entity that consists of multiple data entities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">data collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245">
    <obo:IAO_0000115 xml:lang="en">An organization is a continuant entity which can play roles,  has members, and has a set of organization rules.  Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/Frequency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Frequency</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/accessRights">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Access Rights</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/rights"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/accrualPeriodicity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Accrual Periodicity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/issued">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Date Issued</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">License</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/rights"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/rights">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Rights</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>database_cross_reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>has_exact_synonym</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#narrowMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#keyword">
    <obo:IAO_0000115 xml:lang="en">A keyword or tag describing a resource.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">keyword</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#temporalResolution">
    <obo:IAO_0000115 xml:lang="en">minimum time period resolvable in a dataset.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">temporal resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#version">
    <obo:IAO_0000115 xml:lang="en">The version indicator (name or identifier) of a resource.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">version</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0000001">
    <obo:IAO_0000115 xml:lang="en">The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as "EML 2.2: dataset/title".</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:label xml:lang="en">crosswalk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0000002">
    <obo:IAO_0000115 xml:lang="en">A property the records of this class are expected to carry, such as a title or a year. Records the attributes a class uses without adding domain axioms to terms borrowed from other vocabularies.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:label xml:lang="en">expected attribute</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0000012">
    <obo:IAO_0000115 xml:lang="en">A part of the landscape or a structure in it that records can be located at, worked on or bounded by: a river, a reserve, a dam, a crossing structure.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:label xml:lang="en">place</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0000013">
    <obo:IAO_0000115 xml:lang="en">An information content entity that records or publishes information: a data resource, a paper or a report.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:label xml:lang="en">information resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0005000">
    <obo:IAO_0000115 xml:lang="en">A place or structure on the landscape that conservation works on or around: a water body, a conservation area, a water or energy work, a farm, a sensor, a road or trail. Called infrastructure in the PPOD model whether built or natural.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/infrastructure.owl"/>
    <rdfs:label xml:lang="en">infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0000012"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0006000">
    <obo:IAO_0000115 xml:lang="en">A directive that requires, allows, funds or shapes conservation work: a law, regulation, executive order, agreement, certification standard or guideline. Some bind; others only advise.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/mandates.owl"/>
    <rdfs:label xml:lang="en">guideline or mandate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008000">
    <obo:IAO_0000115 xml:lang="en">Data at any of three levels: a dataset, a database or a data repository. Replaced the PPOD Dataset class.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0000013"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
    <skos:closeMatch rdf:resource="https://schema.org/CreativeWork"/>
    <iconbase:ICON_0000002 rdf:resource="http://purl.org/dc/terms/accessRights"/>
    <iconbase:ICON_0000002 rdf:resource="http://purl.org/dc/terms/accrualPeriodicity"/>
    <iconbase:ICON_0000002 rdf:resource="http://purl.org/dc/terms/description"/>
    <iconbase:ICON_0000002 rdf:resource="http://purl.org/dc/terms/identifier"/>
    <iconbase:ICON_0000002 rdf:resource="http://purl.org/dc/terms/issued"/>
    <iconbase:ICON_0000002 rdf:resource="http://purl.org/dc/terms/license"/>
    <iconbase:ICON_0000002 rdf:resource="http://www.w3.org/ns/dcat#keyword"/>
    <iconbase:ICON_0000002 rdf:resource="http://www.w3.org/ns/dcat#temporalResolution"/>
    <iconbase:ICON_0000002 rdf:resource="http://www.w3.org/ns/dcat#version"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0008200"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0008201"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0008202"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0008203"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0008204"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008001">
    <obo:IAO_0000115 xml:lang="en">One collection of data published as a unit by its creator, such as a map layer, a table or a time series. Example: Cropland Data Layer.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">dataset</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0001000"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0008000"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <skos:closeMatch rdf:resource="https://schema.org/Dataset"/>
    <iconbase:ICON_0000001>DataCite 4.5: resourceTypeGeneral Dataset</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: dataset</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: MD_ScopeCode dataset</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008002">
    <obo:IAO_0000115 xml:lang="en">A maintained collection of related datasets kept together under one design, usually by one organization and usually queryable. Its datasets are part of it. Example: California Natural Diversity Database.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">database</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0001000"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0008000"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <skos:closeMatch rdf:resource="https://schema.org/Dataset"/>
    <iconbase:ICON_0000001>DataCite 4.5: resourceTypeGeneral Dataset</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008003">
    <obo:IAO_0000115 xml:lang="en">A platform that holds and publishes datasets and databases, often from many creators. Example: CDFW BIOS.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data repository</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0008000"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <skos:closeMatch rdf:resource="https://schema.org/DataCatalog"/>
    <iconbase:ICON_0000001>re3data 4.0: repository</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008010">
    <obo:IAO_0000115 xml:lang="en">The form data comes in, from the Terms sheet's dataset types; formats are data types, listed with the kinds of data (#304). DCAT records format on each downloadable distribution; the graph keeps it on the data until a resource has more than one form worth recording.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data format</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0008080"/>
    <iconbase:ICON_0000001>DataCite 4.5: format</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: physical/dataFormat</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: MD_Format</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008011">
    <obo:IAO_0000115 xml:lang="en">Photographs or scanned images.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">image data format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008012">
    <obo:IAO_0000115 xml:lang="en">A grid of cells, each with a value, such as a land cover map or a climate surface.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">raster data format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008013">
    <obo:IAO_0000115 xml:lang="en">Points, lines or polygons with attributes, in the Esri shapefile or a similar vector format.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">shapefile data format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008014">
    <obo:IAO_0000115 xml:lang="en">Rows and columns, as a spreadsheet or a database table.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">tabular data format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008015">
    <obo:IAO_0000115 xml:lang="en">A finished map, interactive on the web or printed, made for people to read rather than as data to analyse. Mostly a tool's output.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">map data format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008016">
    <obo:IAO_0000115 xml:lang="en">A written document, such as a PDF report or a site summary. Mostly a tool's output.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">report data format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008020">
    <obo:IAO_0000115 xml:lang="en">Who can get the data. The Dataset Dictionary's Availability. Each value maps to the EU access-right list and to the DCAT-US access levels data.gov uses.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data access level</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008021">
    <obo:IAO_0000115 xml:lang="en">Anyone can download the data without signing in.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008020"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">open data access</rdfs:label>
    <skos:closeMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <iconbase:ICON_0000001>DCAT-US 1.1: accessLevel public</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008022">
    <obo:IAO_0000115 xml:lang="en">The data is free after creating an account or accepting terms.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008020"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">open access with registration</rdfs:label>
    <skos:broadMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <iconbase:ICON_0000001>DCAT-US 1.1: accessLevel public</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008023">
    <obo:IAO_0000115 xml:lang="en">The data is published with sensitive detail, such as rare species locations, generalized or held back unless a request is approved.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008020"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">sensitive locations withheld</rdfs:label>
    <skos:broadMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
    <iconbase:ICON_0000001>DCAT-US 1.1: accessLevel restricted public</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008024">
    <obo:IAO_0000115 xml:lang="en">The data is available only through an agreement, a subscription or a fee.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008020"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">access by request or license</rdfs:label>
    <skos:closeMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
    <iconbase:ICON_0000001>DCAT-US 1.1: accessLevel restricted public</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008025">
    <obo:IAO_0000115 xml:lang="en">The data is held for its creator's own use.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008020"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data not public</rdfs:label>
    <skos:closeMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"/>
    <iconbase:ICON_0000001>DCAT-US 1.1: accessLevel non-public</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008030">
    <obo:IAO_0000115 xml:lang="en">How far apart in time the data's values are. Each value carries, as a cross-reference, the ISO 8601 duration that dcat:temporalResolution takes on export.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">temporal resolution value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008031">
    <obo:IAO_0000115 xml:lang="en">A value every hour.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ISO8601:PT1H</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">hourly resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008032">
    <obo:IAO_0000115 xml:lang="en">A value every day.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ISO8601:P1D</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">daily resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008033">
    <obo:IAO_0000115 xml:lang="en">A value every week.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ISO8601:P1W</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">weekly resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008034">
    <obo:IAO_0000115 xml:lang="en">A value every month.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ISO8601:P1M</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">monthly resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008035">
    <obo:IAO_0000115 xml:lang="en">A value every year.</obo:IAO_0000115>
    <oboInOwl:hasDbXref>ISO8601:P1Y</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">annual resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008036">
    <obo:IAO_0000115 xml:lang="en">Values for periods longer than a year, such as decades.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">multi-year resolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008037">
    <obo:IAO_0000115 xml:lang="en">One point or period in time.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008030"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">single snapshot</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008040">
    <obo:IAO_0000115 xml:lang="en">A unit of people or property that social data is recorded for. The analysis unit of DDI Discovery.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">social unit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008041">
    <obo:IAO_0000115 xml:lang="en">Data recorded person by person.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">individual person unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008042">
    <obo:IAO_0000115 xml:lang="en">Data recorded household by household.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">household unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008043">
    <obo:IAO_0000115 xml:lang="en">Data recorded by land parcel or landowner.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">parcel or landowner unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008044">
    <obo:IAO_0000115 xml:lang="en">Data recorded organization by organization.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">organization unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008045">
    <obo:IAO_0000115 xml:lang="en">Data recorded by Census block group.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">census block group unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008046">
    <obo:IAO_0000115 xml:lang="en">Data recorded by Census tract.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">census tract unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008047">
    <obo:IAO_0000115 xml:lang="en">Data recorded by city or town.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon-ioc/ICON_0008040"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
