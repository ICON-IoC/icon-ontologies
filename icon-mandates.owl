  <rdf:Description rdf:about="https://w3id.org/icon/mandates.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">Laws, regulations, executive orders, agreements, certifications and guidelines that require, allow, fund or shape conservation work, and the ways organizations stand toward them: bound by, implementing, enforcing, issuing, certified by.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://data.europa.eu/eli/ontology"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
    <dcterms:references rdf:resource="https://schema.org/"/>
    <dcterms:title xml:lang="en">ICON Guidelines and mandates ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Built on: Information Artifact Ontology, Ontology for Biomedical Investigations. Mapped to: European Legislation Identifier (ELI), Ontology of Medically Related Social Entities, schema.org.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/projects.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon/releases/2026-11-21/mandates.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
