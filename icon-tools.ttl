# ICON Tools ontology
# Built by `ioc-ontologies` from ontology/src/tools.terms; edit that file, not this one.
# Guide: ontology/guides/tools.md
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

IAO:0000115 a owl:AnnotationProperty ;
    rdfs:label "definition" .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:references a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

oboInOwl:hasDbXref a owl:AnnotationProperty ;
    rdfs:label "database_cross_reference" .

oboInOwl:hasExactSynonym a owl:AnnotationProperty ;
    rdfs:label "has_exact_synonym" .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

icon:0000001 a owl:AnnotationProperty ;
    rdfs:label "crosswalk"@en ;
    IAO:0000115 "The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as \"EML 2.2: dataset/title\"."@en ;
    rdfs:isDefinedBy iconbase:core.owl .

icon:0000002 a owl:AnnotationProperty ;
    rdfs:label "expected attribute"@en ;
    IAO:0000115 "A property the records of this class are expected to carry, such as a title or a year. Records the attributes a class uses without adding domain axioms to terms borrowed from other vocabularies."@en ;
    rdfs:isDefinedBy iconbase:core.owl .

icon:0013001 a owl:Class ;
    rdfs:label "decision-support tool"@en ;
    IAO:0000115 "A tool that helps choose where or how to act: it ranks or prioritizes sites, compares scenarios, or screens a proposal against conservation values. Example: Ecosystem Management Decision Support System."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf icon:0013000 .

icon:0013002 a owl:Class ;
    rdfs:label "map viewer"@en ;
    IAO:0000115 "A web application for browsing and querying map layers. Example: Wetlands Mapper."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf IAO:0000594,
        icon:0013000 ;
    skos:closeMatch schema:WebApplication .

icon:0013003 a owl:Class ;
    rdfs:label "dashboard"@en ;
    IAO:0000115 "A web page that tracks a set of indicators in charts and maps, often over time. Example: California Carbon Dashboard."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf IAO:0000594,
        icon:0013000 ;
    skos:closeMatch schema:WebApplication .

icon:0013004 a owl:Class ;
    rdfs:label "calculator or model"@en ;
    IAO:0000115 "A tool that computes an estimate from its user's inputs or runs a model, such as the carbon a riparian planting stores or the habitat a site provides. Example: Carbon in Riparian Ecosystems Estimator for California."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf icon:0013000 .

icon:0013006 a owl:Class ;
    rdfs:label "software package"@en ;
    IAO:0000115 "Software its users install and run themselves, such as an R package, a desktop program or a trained model, rather than use on the web. Example: InVEST."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf icon:0013000 ;
    skos:closeMatch schema:SoftwareApplication .

icon:0013007 a owl:Class ;
    rdfs:label "identification key"@en ;
    IAO:0000115 "A guide that leads its user, step by step or by comparing pictures, to the name of a plant or animal they have found. Example: Berkeley BioKeys."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf icon:0013000 .

icon:0013011 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "prioritizing function"@en ;
    IAO:0000115 "Ranks or scores places, sites or projects so the best ones can be chosen first."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013012 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "screening function"@en ;
    IAO:0000115 "Checks a proposed project against rules, sensitive resources or eligibility criteria before it goes ahead."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013013 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "carbon estimating function"@en ;
    IAO:0000115 "Calculates carbon stored or greenhouse gases emitted or avoided."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013014 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "projecting function"@en ;
    IAO:0000115 "Shows how conditions may change under future climate, sea level rise or land use."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013015 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "habitat quantifying function"@en ;
    IAO:0000115 "Measures how much habitat there is and how good it is."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013016 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "mapping function"@en ;
    IAO:0000115 "Shows where resources, conditions or hazards are, for browsing and querying."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013017 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "vulnerability assessing function"@en ;
    IAO:0000115 "Judges how exposed and sensitive people, places or species are to a threat."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013018 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "scenario comparing function"@en ;
    IAO:0000115 "Runs alternative management or development choices side by side to weigh their effects."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013019 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "recommending function"@en ;
    IAO:0000115 "Suggests what to do or plant, such as fertilizer rates, seedlots or meadow species."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013020 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "tracking function"@en ;
    IAO:0000115 "Records projects, prices or indicators over time and reports on them."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013021 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "species detecting function"@en ;
    IAO:0000115 "Finds and counts animals or plants, as in images."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

icon:0013022 a owl:NamedIndividual,
        icon:0013010 ;
    rdfs:label "funding application function"@en ;
    IAO:0000115 "Helps applicants build a proposal or meet the requirements of a grant program."@en ;
    rdfs:isDefinedBy iconbase:tools.owl .

BFO:0000001 a owl:Class ;
    rdfs:label "entity"@en .

BFO:0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf BFO:0000001 .

BFO:0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    IAO:0000115 "b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])"@en ;
    rdfs:subClassOf BFO:0000002 .

IAO:0000033 a owl:Class ;
    rdfs:label "directive information entity"@en ;
    IAO:0000115 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en ;
    rdfs:subClassOf IAO:0000030 .

IAO:0000104 a owl:Class ;
    rdfs:label "plan specification"@en ;
    IAO:0000115 "A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."@en ;
    rdfs:subClassOf IAO:0000033 .

dcterms:description a owl:AnnotationProperty ;
    rdfs:label "Description"@en .

icon:0013100 a owl:ObjectProperty ;
    rdfs:label "has tool type"@en ;
    IAO:0000115 "Links a tool to a kind of tool it is. A tool can be of several kinds, as a map viewer that also prioritizes sites."@en ;
    rdfs:domain icon:0013000 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    owl:inverseOf icon:0013101 ;
    skos:closeMatch schema:applicationCategory .

icon:0013101 a owl:ObjectProperty ;
    rdfs:label "is tool type of"@en ;
    IAO:0000115 "The reverse of has tool type."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0013000 ;
    owl:inverseOf icon:0013100 .

icon:0013102 a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    IAO:0000115 "The tool creates or serves this data: the layers a map viewer publishes, the estimates a calculator outputs. The workbook's outDataset column."@en ;
    rdfs:domain icon:0013000 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0008000 ;
    owl:inverseOf icon:0013103 .

icon:0013103 a owl:ObjectProperty ;
    rdfs:label "is produced by"@en ;
    IAO:0000115 "The reverse of produces."@en ;
    rdfs:domain icon:0008000 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0013000 ;
    owl:inverseOf icon:0013102 ;
    skos:closeMatch prov:wasGeneratedBy .

icon:0013104 a owl:ObjectProperty ;
    rdfs:label "has tool function"@en ;
    IAO:0000115 "Links a tool to something it does for its user."@en ;
    rdfs:domain icon:0013000 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    owl:inverseOf icon:0013105 .

icon:0013105 a owl:ObjectProperty ;
    rdfs:label "is tool function of"@en ;
    IAO:0000115 "The reverse of has tool function."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0013000 ;
    owl:inverseOf icon:0013104 .

icon:0013106 a owl:ObjectProperty ;
    rdfs:label "takes input"@en ;
    IAO:0000115 "A kind of data, or a format, the tool takes in, from the Data type list that also describes Data records, so data can be matched to the tools that take it. A specific Data record the tool uses is a uses data from link instead."@en ;
    rdfs:domain icon:0013000 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0008080 ;
    owl:inverseOf icon:0013107 ;
    icon:0000001 "EDAM: has_input" .

icon:0013107 a owl:ObjectProperty ;
    rdfs:label "is input to"@en ;
    IAO:0000115 "The reverse of takes input."@en ;
    rdfs:domain icon:0008080 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0013000 ;
    owl:inverseOf icon:0013106 .

icon:0013108 a owl:ObjectProperty ;
    rdfs:label "gives output"@en ;
    IAO:0000115 "A kind of data, or a format, the tool gives back, from the Data type list. A specific Data record the tool creates is a produces link instead."@en ;
    rdfs:domain icon:0013000 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0008080 ;
    owl:inverseOf icon:0013109 ;
    icon:0000001 "EDAM: has_output" .

icon:0013109 a owl:ObjectProperty ;
    rdfs:label "is output from"@en ;
    IAO:0000115 "The reverse of gives output."@en ;
    rdfs:domain icon:0008080 ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:range icon:0013000 ;
    owl:inverseOf icon:0013108 .

IAO:0000010 a owl:Class ;
    rdfs:label "software"@en ;
    IAO:0000115 """Software is a plan specification composed of a series of instructions that can be 
interpreted by or directly executed by a processing unit."""@en ;
    rdfs:subClassOf IAO:0000104 .

IAO:0000594 a owl:Class ;
    rdfs:label "software application"@en ;
    IAO:0000115 "A software application is software that can be directly executed by some processing unit."@en ;
    rdfs:subClassOf IAO:0000010 .

icon:0000013 a owl:Class ;
    rdfs:label "information resource"@en ;
    IAO:0000115 "An information content entity that records or publishes information: a data resource, a paper or a report."@en ;
    rdfs:isDefinedBy iconbase:core.owl ;
    rdfs:subClassOf IAO:0000030 .

icon:0008000 a owl:Class ;
    rdfs:label "data resource"@en ;
    IAO:0000115 "Data at any of three levels: a dataset, a database or a data repository. Replaced the PPOD Dataset class."@en ;
    rdfs:isDefinedBy iconbase:data.owl ;
    rdfs:subClassOf icon:0000013 .

IAO:0000030 a owl:Class ;
    rdfs:label "information content entity"@en ;
    IAO:0000115 "A generically dependent continuant that is about some thing."@en ;
    rdfs:subClassOf BFO:0000031 .

icon:0008080 a owl:Class ;
    rdfs:label "data type"@en ;
    IAO:0000115 "The kind of data, or the form it comes in. One list holds both, so a Data record and a tool's input or output are described in the same terms and a dataset can be matched to the tools that take it: Land cover or vegetation map and Raster describe both the Cropland Data Layer and an input InVEST takes."@en ;
    rdfs:isDefinedBy iconbase:data.owl ;
    rdfs:subClassOf IAO:0000030 .

icon:0013010 a owl:Class ;
    rdfs:label "tool function"@en ;
    IAO:0000115 "What a tool does for its user, such as prioritizing places or estimating carbon. A tool can have several."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf IAO:0000030 ;
    skos:closeMatch schema:featureList .

icon:0013000 a owl:Class ;
    rdfs:label "tool"@en ;
    IAO:0000115 "Software people use to plan, assess or track conservation work: a decision-support tool, a map viewer, a dashboard, a calculator or model, a software package or an identification key. A site whose main job is holding and serving data is a data repository, not a tool; a tool that works with such data links to it. Read from the master PPOD workbook's Tools sheet."@en ;
    rdfs:isDefinedBy iconbase:tools.owl ;
    rdfs:subClassOf IAO:0000010,
        icon:0000013 ;
    skos:closeMatch schema:SoftwareApplication ;
    icon:0000002 dcterms:description .

iconbase:tools.owl a owl:Ontology ;
    dcterms:creator "Internet of Conservation (ICON)" ;
    dcterms:description "Software people use to plan, assess and track conservation work: decision-support tools, map viewers, dashboards, calculators and models, and software packages. Covers who builds and uses them, the issues they address, and the data they take in and produce."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:references obo:iao.owl,
        dcterms:,
        <http://www.w3.org/ns/prov-o>,
        schema: ;
    dcterms:title "ICON Tools ontology"@en ;
    rdfs:comment "Existing ontologies used. Built on: Dublin Core terms, Information Artifact Ontology. Mapped to: PROV-O (W3C provenance), schema.org."@en ;
    rdfs:seeAlso iconbase:core.owl,
        iconbase:data.owl ;
    owl:versionIRI <https://w3id.org/icon/releases/2026-11-21/tools.owl> ;
    owl:versionInfo "2026-11-21" .

