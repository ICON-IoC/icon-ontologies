  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
    <obo:IAO_0000115 xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">independent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">object aggregate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
    <obo:IAO_0000115 xml:lang="en">b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">material entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000254">
    <obo:IAO_0000115 xml:lang="en">A system which has the disposition to environ one or more material entities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">environmental system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000739">
    <obo:IAO_0000115 xml:lang="en">An environmental system which can sustain and allow the growth of an ecological population.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">habitat</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001110"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000813">
    <obo:IAO_0000115 xml:lang="en">A material part of an astronomical body.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001110">
    <obo:IAO_0000115 xml:lang="en">An environmental system which includes both living and non-living components.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ecosystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000254"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
    <obo:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">information content entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>definition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000000">
    <obo:IAO_0000115 xml:lang="en">A material entity that consists of two or more organisms, viruses, or viroids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collection of organisms</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000031">
    <obo:IAO_0000115 xml:lang="en">A material entity that is one or more organisms, viruses or viroids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organismal entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000059">
    <obo:IAO_0000115 xml:lang="en">A collection of organisms that has as members every organism of a taxon and no organisms of any other equal or higher ranked taxon. The taxon may be at any level. If the taxon is species, then this is the same as the class species as a collection of organisms. When defining a taxon, it is generally understood that members include both living organisms and dead organisms that are known through specimens or observations.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">taxon as collection of organisms</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002577">
    <obo:IAO_0000115 xml:lang="en">A material entity consisting of multiple components that are causally integrated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rs.tdwg.org/dwc/terms/scientificName">
    <obo:IAO_0000115 xml:lang="en">The full scientific name, with authorship and date information if known. When forming part of a dwc:Identification, this should be the name in lowest level taxonomic rank that can be determined.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Scientific Name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://rs.tdwg.org/dwc/terms/taxonID">
    <obo:IAO_0000115 xml:lang="en">An identifier for a dwc:Taxon.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Taxon ID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://rs.tdwg.org/dwc/terms/vernacularName">
    <obo:IAO_0000115 xml:lang="en">A common or vernacular name.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">Vernacular Name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>database_cross_reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>has_exact_synonym</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <obo:IAO_0000115 xml:lang="en">A statement or formal explanation of the meaning of a concept.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">definition</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#narrowMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#note">
    <obo:IAO_0000115 xml:lang="en">A general note, for any purpose.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000001">
    <obo:IAO_0000115 xml:lang="en">The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as "EML 2.2: dataset/title".</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">crosswalk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000002">
    <obo:IAO_0000115 xml:lang="en">A property the records of this class are expected to carry, such as a title or a year. Records the attributes a class uses without adding domain axioms to terms borrowed from other vocabularies.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">expected attribute</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011000">
    <obo:IAO_0000115 xml:lang="en">A species or a group of species that records concern, identified by its NatureServe element where it has one. Groups (salmonids, bats) are taxa at a higher rank or informal groupings of them.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">taxon</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000059"/>
    <skos:closeMatch rdf:resource="http://rs.tdwg.org/dwc/terms/Taxon"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/scientificName"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/taxonID"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/vernacularName"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011200"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011201"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011202"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011203"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011204"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011205"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011001">
    <obo:IAO_0000115 xml:lang="en">A habitat type of the California Wildlife Habitat Relationships system, the state's standard classification of wildlife habitats (59 types, such as Valley Foothill Riparian or Blue Oak Woodland), identified by its CWHR code.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CWHR habitat type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011002">
    <obo:IAO_0000115 xml:lang="en">How invasive a non-native species is in California: for plants, the California Invasive Plant Council (Cal-IPC) rating in its Inventory, High, Moderate, Limited, or Watch for a plant at high risk of becoming invasive (#410); for animals, listing by the California Department of Fish and Wildlife (CDFW), which does not rate them (#435).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">invasive rating</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011003">
    <obo:IAO_0000115 xml:lang="en">The California Native Plant Society's rank of how rare a plant, bryophyte, or lichen is in California, from 1A (presumed extirpated or extinct) to 4 (a watch list of limited distribution), assigned with CDFW's California Natural Diversity Database and printed in its Special Vascular Plants, Bryophytes, and Lichens List. The decimal threat rank that follows it (.1 seriously, .2 moderately, .3 not very threatened) is kept as the link's source note (#1210).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011004">
    <obo:IAO_0000115 xml:lang="en">A unit of vegetation: an alliance of the Manual of California Vegetation, as CDFW's California Natural Communities List names it (such as Valley oak woodland and forest, or Fremont's goldfields - Downingia vernal pools), or a group, macrogroup or division of the US National Vegetation Classification above it (#1409).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Finer than a CWHR habitat type. An alliance has its USNVC group as a broader habitat type, and the CWHR type CNPS places it in when there is one; where CNPS names several, it is related to each.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">vegetation type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/scientificName"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011210"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011211"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011212"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011213"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011214"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011215"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011005">
    <obo:IAO_0000115 xml:lang="en">A unit of the Coastal and Marine Ecological Classification Standard (CMECS, FGDC-STD-018-2012): a system, subsystem or tidal zone of its Aquatic Setting (such as Estuarine Coastal Intertidal Tidal Zone), or a biotic setting, class, subclass or group of its Biotic Component (such as Seagrass Bed), identified by its CMECS ID (#1410).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Finer than CWHR for estuaries, shores and the ocean. A unit has the unit above it as a broader habitat type; units are crosswalked to CWHR by hand in reference/cmecs-cwhr.csv, as broader where one CWHR type matches and related where several do.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">coastal and marine habitat type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
    <iconbase:ICON_0000002 rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011220"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011221"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011222"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011006">
    <obo:IAO_0000115 xml:lang="en">A unit of the IUCN Global Ecosystem Typology 2.0 (Keith et al. 2022), the global classification of ecosystems by how they function: one of its 11 realms (such as Terrestrial), 25 biomes (such as Savannas and grasslands biome) or 110 ecosystem functional groups (such as T4.4 Temperate woodlands), identified by its GET code and IRI (#1411).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Records are not tagged with GET. Every CWHR, MCV and CMECS term has the GET units it falls in as IUCN ecosystem groups, so a record's habitat types lead to them. Within GET, a functional group has its biome, and a biome its realm, as broader habitat types.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">IUCN ecosystem type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
    <iconbase:ICON_0000002 rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <iconbase:ICON_0000002 rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011230"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011231"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011232"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011010">
    <obo:IAO_0000115 xml:lang="en">Cal-IPC: severe ecological impacts on physical processes, plant and animal communities and vegetation structure, with rates of dispersal and establishment that are moderate to high; most are widely distributed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">high invasive rating</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011011">
    <obo:IAO_0000115 xml:lang="en">Cal-IPC: substantial and apparent, but generally not severe, ecological impacts, with moderate to high rates of dispersal, though establishment generally depends on disturbance.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">moderate invasive rating</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011012">
    <obo:IAO_0000115 xml:lang="en">Cal-IPC: invasive, but with ecological impacts that are minor statewide, or too little information to rate it higher; often locally persistent and problematic.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">limited invasive rating</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011013">
    <obo:IAO_0000115 xml:lang="en">Cal-IPC: not yet invasive in California's wildlands, but assessed as at high risk of becoming invasive here.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">watch invasive rating</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011014">
    <obo:IAO_0000115 xml:lang="en">CDFW: an animal on the Invasive Species Program's list California's Invaders, as invasive in California or a threat to the state; CDFW does not rate how invasive it is (#435).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CDFW listed invasive rating</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011020">
    <obo:IAO_0000115 xml:lang="en">CNPS: Plants presumed extirpated in California and either rare or extinct elsewhere: not seen or collected in the wild in California for many years.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank 1A</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011021">
    <obo:IAO_0000115 xml:lang="en">CNPS: Plants rare, threatened, or endangered in California and elsewhere; most are endemic to California and have declined significantly over the last century.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank 1B</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011022">
    <obo:IAO_0000115 xml:lang="en">CNPS: Plants presumed extirpated in California but common elsewhere.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank 2A</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011023">
    <obo:IAO_0000115 xml:lang="en">CNPS: Plants rare, threatened, or endangered in California but more common elsewhere.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank 2B</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011024">
    <obo:IAO_0000115 xml:lang="en">CNPS: Review list: plants about which more information is needed, nearly all taxonomically problematic.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank 3</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011025">
    <obo:IAO_0000115 xml:lang="en">CNPS: Watch list: plants of limited distribution or infrequent throughout a broader area of California, whose status should be monitored.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">California Rare Plant Rank 4</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011100">
    <obo:IAO_0000115 xml:lang="en">The record is about, works for or affects the species or group.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">concerns taxon</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011101"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/subject"/>
    <iconbase:ICON_0000001>EML 2.2: coverage/taxonomicCoverage</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011101">
    <obo:IAO_0000115 xml:lang="en">The reverse of concerns taxon.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is taxon of</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011100"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011102">
    <obo:IAO_0000115 xml:lang="en">A CWHR habitat type (#169), vegetation type (#1409) or coastal and marine habitat type (#1410) the record covers, works in or affects.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has habitat type</rdfs:label>
    <rdfs:range rdf:nodeID="cb122492299744b3de4f84f1972ce0732266e1088fa07e644871ecd1485632d0263"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011103"/>
    <owl:propertyChainAxiom rdf:nodeID="cb248f6ff17690750b0676109766cbc3fe91d161d0d6d8368a3d5dbfe386d32ddeb"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/subject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011103">
    <obo:IAO_0000115 xml:lang="en">The reverse of has habitat type.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cbbe31f47b383ba848f1300380aaacda6bed75ff59aee832870287dde1f2285756"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is habitat type of</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011102"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011104">
    <obo:IAO_0000115 xml:lang="en">The taxon is invasive in California, or at risk of becoming so, with this Cal-IPC rating (#410) or CDFW listing (#435).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has invasive rating</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011105"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011105">
    <obo:IAO_0000115 xml:lang="en">The reverse of has invasive rating.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is invasive rating of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011104"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011106">
    <obo:IAO_0000115 xml:lang="en">The plant, bryophyte, or lichen has this California Rare Plant Rank in CDFW's Special Vascular Plants, Bryophytes, and Lichens List (#1210).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has rare plant rank</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011107">
    <obo:IAO_0000115 xml:lang="en">The reverse of has rare plant rank.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011003"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is rare plant rank of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011106"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011108">
    <obo:IAO_0000115 xml:lang="en">Links a habitat or vegetation type to a broader one that contains it: an MCV alliance to its USNVC group, a group to its macrogroup, a CMECS unit to the unit above it, a GET functional group to its biome and a biome to its realm, and an alliance or CMECS unit to the one CWHR habitat type it falls in. A record that has the narrower type has the broader one too (#1409, #1410, #1411).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cb1207556a8d1ca62e3286a72f32cf9f98b1d671c8f882ced801e1c3f0c5819a7b8"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has broader habitat type</rdfs:label>
    <rdfs:range rdf:nodeID="cb1ad31808eeaf658d8dddc3da6b8595671b8001a25efb0ac4b3decf5e5679a5f3d"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011109"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011109">
    <obo:IAO_0000115 xml:lang="en">The reverse of has broader habitat type.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cb15d406f7c583277fdeda05da6bead582b3be0f676cec3499d4fe6f01953a4cced"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has narrower habitat type</rdfs:label>
    <rdfs:range rdf:nodeID="cb105cd45ad20f40a7a512527e1780e605a759a896ac303dd8a9b32d1eb0de3c8af"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011108"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011110">
    <obo:IAO_0000115 xml:lang="en">Links an MCV alliance or CMECS unit to each CWHR habitat type it may fall in, when there is more than one: a stand of it falls within one of them, but not always the same one. Nothing passes along it (#1409, #1410).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:nodeID="cb168a5ccfa73b284efbcd9024a0338d7891085f81cc90ddf2286f450f7e7b361e9"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is related to habitat type</rdfs:label>
    <rdfs:range rdf:nodeID="cb21d56dc5f58f2eccfb00081c133524413a24cd81d89f6df0653ce88d77400cd96"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011111">
    <obo:IAO_0000115 xml:lang="en">Links a CWHR, MCV or CMECS habitat type to the IUCN GET ecosystem functional groups it falls in, or to the biome or realm when it spans several of their groups. Mapped by hand in reference/get-crosswalk.csv at the broadest unit where the match holds and stated on every unit below it. Nothing passes along it: records are not tagged with GET (#1411).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cb1faa0cdd975aff79633b01bd40030d7b1abf5caff3eedf2c11abd4f0fde73bce7"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has IUCN ecosystem group</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011006"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011112"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#broadMatch"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011112">
    <obo:IAO_0000115 xml:lang="en">The reverse of has IUCN ecosystem group.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011006"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is IUCN ecosystem group of</rdfs:label>
    <rdfs:range rdf:nodeID="cb1c549b7d508f9f1d8ed06e40314bff860a71627a42ede8a46772a62c773be2a79"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0011111"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#narrowMatch"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011200">
    <obo:IAO_0000115 xml:lang="en">The taxon's NatureServe conservation status across its whole range, G1 (critically imperiled) to G5 (secure), with T ranks for subspecies.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">NatureServe global rank</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011201">
    <obo:IAO_0000115 xml:lang="en">Whether the term is a single NatureServe taxon (taxon), a group of taxa (group), or matched nothing in NatureServe (none).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">taxon kind</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011202">
    <obo:IAO_0000115 xml:lang="en">NatureServe's informal taxonomy path for the taxon, such as Animals | Vertebrates | Birds.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">informal group</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011203">
    <obo:IAO_0000115 xml:lang="en">For a group, what defines it: NatureServe's informal taxonomy, or a rank of its scientific taxonomy (kingdom, phylum, class, order, family, subfamily, genus).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">group level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011204">
    <obo:IAO_0000115 xml:lang="en">For a group, the name at its group level, such as Salmoninae for a subfamily group.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">group value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011205">
    <obo:IAO_0000115 xml:lang="en">For a subfamily group, which NatureServe cannot search by rank, the genera it spans, separated by semicolons: Oncorhynchus; Salmo; Salvelinus.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">genera</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011210">
    <obo:IAO_0000115 xml:lang="en">Where the vegetation type sits: an MCV Alliance, Semi-Natural Alliance (dominated by non-native plants) or Special Stands, or a USNVC Group, Macrogroup or Division.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011004"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">vegetation classification level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011211">
    <obo:IAO_0000115 xml:lang="en">The alliance's code on CDFW's California Natural Communities List, such as 71.035.00 for Valley oak woodland and forest.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011004"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CDFW CaCode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011212">
    <obo:IAO_0000115 xml:lang="en">The alliance's primary life form on the Natural Communities List: Tree, Shrub, Herb or Non-vascular.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011004"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">life form</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011213">
    <obo:IAO_0000115 xml:lang="en">How rare and threatened the alliance is across its whole range, G1 (very rare and threatened) to G5 (secure), from NatureServe's method as CDFW applies it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011004"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">natural community global rank</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011214">
    <obo:IAO_0000115 xml:lang="en">How rare and threatened the alliance is in California, S1 to S5; SNA for a semi-natural alliance, which is not ranked.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011004"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">natural community state rank</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011215">
    <obo:IAO_0000115 xml:lang="en">Yes for an alliance with a state rank of S1 to S3, which CDFW counts as a sensitive natural community for environmental review under CEQA.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011004"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">sensitive natural community</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011220">
    <obo:IAO_0000115 xml:lang="en">Where the CMECS unit sits: a System, Subsystem or Tidal Zone of the Aquatic Setting, or a Biotic Setting, Biotic Class, Biotic Subclass or Biotic Group of the Biotic Component.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011005"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CMECS classification level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011221">
    <obo:IAO_0000115 xml:lang="en">The unit's code in the CMECS Catalog, its component's letter (A for the Aquatic Setting, B for the Biotic Component) followed by its unit code, such as B2.5.2.1 for Seagrass Bed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011005"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CMECS code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011222">
    <obo:IAO_0000115 xml:lang="en">The unit's permanent identifier in the CMECS Catalog, such as CMECS_00000721; https://w3id.org/CMECS/ followed by it is the unit's IRI.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011005"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CMECS ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/identifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011230">
    <obo:IAO_0000115 xml:lang="en">Where the IUCN GET unit sits: a Realm, a Biome or a Functional group (an ecosystem functional group).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011006"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">GET classification level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011231">
    <obo:IAO_0000115 xml:lang="en">The unit's code in the IUCN Global Ecosystem Typology: a realm's letters (T, or MT for a transitional realm), a biome's (T4) or a functional group's (T4.4).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011006"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">GET code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011232">
    <obo:IAO_0000115 xml:lang="en">The unit's permanent identifier in the IUCN GET SKOS vocabulary, such as https://w3id.org/iucn-get/EFG_T4_4.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011006"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">GET IRI</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/identifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/biodiversity.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">The living things and habitats records concern: taxa (species and groups, identified by NatureServe) habitat types (California Wildlife Habitat Relationships), vegetation types (Manual of California Vegetation alliances under the US National Vegetation Classification) coastal and marine habitat types (CMECS) and the IUCN Global Ecosystem Typology, the links between those classifications, and the links that say a record concerns a taxon or a habitat type, or that a place is habitat for a taxon.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/pco.owl"/>
    <dcterms:references rdf:resource="http://purl.org/dc/terms/"/>
    <dcterms:references rdf:resource="http://rs.tdwg.org/dwc/terms/"/>
    <dcterms:references rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <dcterms:title xml:lang="en">ICON Taxa and habitats ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Reused: Darwin Core, SKOS. Built on: Environment Ontology, Information Artifact Ontology, Population and Community Ontology, SKOS. Mapped to: Darwin Core, Dublin Core terms, SKOS.</rdfs:comment>
    <owl:versionIRI rdf:resource="https://w3id.org/icon/releases/2026-11-21/biodiversity.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
