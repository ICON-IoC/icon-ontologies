  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
    <obo:IAO_0000115 xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">independent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fiat object part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">object aggregate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
    <obo:IAO_0000115 xml:lang="en">b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">material entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/COB_0000026">
    <obo:IAO_0000115 xml:lang="en">A material entity processed by human activity with an intent to produce it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">processed material entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/COB_0001300">
    <obo:IAO_0000115 xml:lang="en">A processed material entity which is designed to be capable of a process.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">device</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000026"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000000">
    <obo:IAO_0000115 xml:lang="en">An astrononmical body part which delimited by physical discontinuities with its surroundings.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">geographic feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000012">
    <obo:IAO_0000115 xml:lang="en">A geographical feature associated with water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hydrographic feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000000"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000014">
    <obo:IAO_0000115 xml:lang="en">Artificial watercourse with no flow or a controlled flow used for navigation, drainage or irrigation.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">canal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000029"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000020">
    <obo:IAO_0000115 xml:lang="en">A body of water or other liquid of considerable size contained in a depression on a landmass.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">lake</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000617"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000023">
    <obo:IAO_0000115 xml:lang="en">A watercourse which is linear and flows across the solid portion of a planetary surface.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stream</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000029"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000025">
    <obo:IAO_0000115 xml:lang="en">An artificial body of water, often contained by a dam, constructed for the purpose of water storage.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reservoir</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000377"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000029">
    <obo:IAO_0000115 xml:lang="en">A flowing body of water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">watercourse</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000618"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000043">
    <obo:IAO_0000115 xml:lang="en">An vegetated area which overlaps a wetland ecosystem.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">wetland area</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001305"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000045">
    <obo:IAO_0000115 xml:lang="en">A semi-enclosed coastal body of water with one or more rivers or streams flowing into it, and with a free connection to the open sea.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">estuary</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000063"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000063">
    <obo:IAO_0000115 xml:lang="en">An accumulation of water of varying size.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">water body</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000685"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000070">
    <obo:IAO_0000115 xml:lang="en">A construction that has been assembled by deliberate human effort.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">human construction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001813"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073">
    <obo:IAO_0000115 xml:lang="en">A permanent walled and roofed construction.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">building</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000074">
    <obo:IAO_0000115 xml:lang="en">A barrier constructed across a watercourse to control the flow or raise the level of water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">dam</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000467"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000178">
    <obo:IAO_0000115 xml:lang="en">An artificial slope or wall, usually earthen, which parallels the course of a river, built for the purpose of containing the river.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">levee</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000012"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000191">
    <obo:IAO_0000115 xml:lang="en">A part of an astronomical body which is primarily composed of solid material.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">solid astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001784"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000256">
    <obo:IAO_0000115 xml:lang="en">The stream channel and adjacent areas that carry flood flows in a flood plain.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">floodway</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000309"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000277">
    <obo:IAO_0000115 xml:lang="en">A lake that has either permanently or temporally lost its water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">dry lake</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000309"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000309">
    <obo:IAO_0000115 xml:lang="en">A landform sunken or depressed below the surrounding area.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">depressed landform</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000377">
    <obo:IAO_0000115 xml:lang="en">A lake purposefully constructed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">artificial lake</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000020"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000535">
    <obo:IAO_0000115 xml:lang="en">A low obstruction built across the path of s stream to raise its level.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">weir</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000074"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00001999">
    <obo:IAO_0000115 xml:lang="en">A lentic water body which is composed primarily of marine water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">marine water body</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000617"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002000">
    <obo:IAO_0000115 xml:lang="en">A solid astronomical body part which is part of the planetary surface between the peak of an elevation or the bottom of a depression and relatively flat surrounding land.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">slope</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002214">
    <obo:IAO_0000115 xml:lang="en">A power plant is a building which contains one or more generators which convert mechanical energy into electrical energy through the relative motion between a magnetic field and a conductor. The energy source harnessed to turn the generator varies widely.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">power plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003861"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002215">
    <obo:IAO_0000115 xml:lang="en">A geothermal power plant is a power plant which uses heat generated by the decay of radioactive isotopes in the Earth's mantle and crust as well as primordial heat left over from the formation of the Earth to drive its generators.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">geothermal power plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002214"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00003861">
    <obo:IAO_0000115 xml:lang="en">An industrial building is a building within which goods are produced and, optionally, stored or within which services are rendered.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">industrial building</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000254">
    <obo:IAO_0000115 xml:lang="en">A system which has the disposition to environ one or more material entities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">environmental system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000408">
    <obo:IAO_0000115 xml:lang="en">A site which has its extent determined by the presence or influence of one or more components of an environmental system or the processes occurring therein.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">environmental zone</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000467">
    <obo:IAO_0000115 xml:lang="en">A constructed barrier is a freestanding wall, berm, or fence built to limit movement of entities across a boundary.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">constructed barrier</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000617">
    <obo:IAO_0000115 xml:lang="en">A lentic water body is a water body in which the accumulated water, in its totality, has very little to no directed flow.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">lentic water body</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000063"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000618">
    <obo:IAO_0000115 xml:lang="en">A lotic water body is a water body in which the accumulated water, in its totality, is flowing.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">lotic water body</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000063"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000685">
    <obo:IAO_0000115 xml:lang="en">A mass of water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">water mass</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001476"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000813">
    <obo:IAO_0000115 xml:lang="en">A material part of an astronomical body.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000930">
    <obo:IAO_0000115 xml:lang="en">An ecosystem which bridges two or more adjoining ecosystems and through which organisms may move or propagate.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ecological corridor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001110"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001110">
    <obo:IAO_0000115 xml:lang="en">An environmental system which includes both living and non-living components.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ecosystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000254"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001199">
    <obo:IAO_0000115 xml:lang="en">An environmental zone which is bounded by material parts of a land mass or the atmosphere or space adjacent to it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">terrestrial environmental zone</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000408"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001305">
    <obo:IAO_0000115 xml:lang="en">A vegetated area is a geographic feature which has ground cover dominated by plant communities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">vegetated area</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001199"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001476">
    <obo:IAO_0000115 xml:lang="en">A liquid astronomical body part which is continuous and is delimited by physical discontinuities or non-liquid boundaries.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">body of liquid</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001477"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001477">
    <obo:IAO_0000115 xml:lang="en">A part of an astronomical body which is primarily composed of liquid material.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">liquid astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001479"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001784"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001479">
    <obo:IAO_0000115 xml:lang="en">A part of an astronomical body which is primarily composed of fluid.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001567">
    <obo:IAO_0000115 xml:lang="en">An environmental zone which 1) contains ecosystems, constructed features, or other entities deemed to be of natural, historical, cultural, or other significance and 2) has been afforded legal protections restricting one or more forms of use by a competent authority.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">protected area</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01003020"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001784">
    <obo:IAO_0000115 xml:lang="en">A part of an astronomical body which is composed of a continuous medium bearing liquid, gaseous, and solid material in variable quantities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">compound astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001813">
    <obo:IAO_0000115 xml:lang="en">A material entity which has been assembled through the intentional, instinctual, or deliberately programmed efforts of an organism or machine.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">construction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001884">
    <obo:IAO_0000115 xml:lang="en">A landform which occurs on the surface of an astronomical body.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">surface landform</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001886">
    <obo:IAO_0000115 xml:lang="en">A solid astronomical body part which has been formed from and is composed primarily of the matter of that astronomical body.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">landform</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000191"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01003020">
    <obo:IAO_0000115 xml:lang="en">A part of an environmental system whose boundaries are determined by fiat.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fiat part of an astronomical object</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
    <obo:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">information content entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>definition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245">
    <obo:IAO_0000115 xml:lang="en">An organization is a continuant entity which can play roles,  has members, and has a set of organization rules.  Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000000">
    <obo:IAO_0000115 xml:lang="en">A material entity that consists of two or more organisms, viruses, or viroids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collection of organisms</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000031">
    <obo:IAO_0000115 xml:lang="en">A material entity that is one or more organisms, viruses or viroids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organismal entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000059">
    <obo:IAO_0000115 xml:lang="en">A collection of organisms that has as members every organism of a taxon and no organisms of any other equal or higher ranked taxon. The taxon may be at any level. If the taxon is species, then this is the same as the class species as a collection of organisms. When defining a taxon, it is generally understood that members include both living organisms and dead organisms that are known through specimens or observations.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">taxon as collection of organisms</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002163">
    <obo:IAO_0000115 xml:lang="en">A is spatially_disjoint_from B if and only if they have no parts in common</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">spatially disjoint from</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002323"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002220">
    <obo:IAO_0000115 xml:lang="en">x adjacent to y if and only if x and y share a boundary.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">adjacent to</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002163"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002323">
    <obo:IAO_0000115 xml:lang="en">A mereological relationship or a topological relationship</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">mereotopologically related to</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002577">
    <obo:IAO_0000115 xml:lang="en">A material entity consisting of multiple components that are causally integrated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>database_cross_reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>has_exact_synonym</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#narrowMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000001">
    <obo:IAO_0000115 xml:lang="en">The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as "EML 2.2: dataset/title".</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">crosswalk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000012">
    <obo:IAO_0000115 xml:lang="en">A part of the landscape or a structure in it that records can be located at, worked on or bounded by: a river, a reserve, a dam, a crossing structure.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">place</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000100">
    <obo:IAO_0000115 xml:lang="en">A link between two records that work together or affect one another. Every more specific involvement link (leads, funds, manages, uses, is partner of and others) implies it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">is involved with</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005000">
    <obo:IAO_0000115 xml:lang="en">A place or structure on the landscape that conservation works on or around: a water body, a conservation area, a water or energy work, a farm, a sensor, a road or trail. Called infrastructure in the PPOD model whether built or natural.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0000012"/>
    <skos:closeMatch rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005001">
    <obo:IAO_0000115 xml:lang="en">A body of water: a river or stream, a lake or pond, a dry lake or playa, a wetland, an estuary or the ocean.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">blue infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:equivalentClass rdf:nodeID="cb15fb4cd47163a2160bdd8b4e5e850bf86f13e8551c8866582704ffa5f55749a19"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005002">
    <obo:IAO_0000115 xml:lang="en">Land or water held or designed for wildlife and habitat: conservation areas, mitigation banks, greenbelts, corridors and crossing structures.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">green infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:equivalentClass rdf:nodeID="cbb63a4fd662b3707dddc8d29eabf3431d65b8dd1489d8cd52b8f0dcdb9bc6a176"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005003">
    <obo:IAO_0000115 xml:lang="en">A work that stores, moves, controls or recharges water.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">water infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:equivalentClass rdf:nodeID="cb11118aca3a1fc7d434fb4f4c45161c35e9b17cd171ef1aacff818602f0f4b6d01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005004">
    <obo:IAO_0000115 xml:lang="en">A work that generates or carries electric power.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">energy infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:equivalentClass rdf:nodeID="cbf272a637875946b2f9e5b572f6ef3f096e2f25b08f521dc41c6ca358df7001bc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005005">
    <obo:IAO_0000115 xml:lang="en">Land or facilities used to grow crops or raise animals.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">food production infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:equivalentClass rdf:nodeID="cbc058ee5fc8b28b4fa6a4c6cf016c9f6a0567b1d8488822e7c43ad5dc9fee8b72"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005006">
    <obo:IAO_0000115 xml:lang="en">A device placed in the landscape to record what passes or happens there.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">sensor infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005007">
    <obo:IAO_0000115 xml:lang="en">A route that carries people, vehicles or goods across the landscape: a trail, a highway, a local road, a railway or a bridge.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">transport infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:equivalentClass rdf:nodeID="cb11b335a01cf7d552b396517524f6df370f2013755abc7348fa953648c12ab40fb"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005008">
    <obo:IAO_0000115 xml:lang="en">How a protected place is managed for biodiversity on the USGS Gap Analysis Project scale, as California's 30x30 Conserved Areas rate it; only GAP 1 and 2 count toward 30x30 (#427).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">GAP status</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005009">
    <obo:IAO_0000115 xml:lang="en">A facility that receives, stores or disposes of solid waste, such as a landfill.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">waste infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005000"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005020">
    <obo:IAO_0000115 xml:lang="en">An aquifer or group of aquifers managed as a unit, such as a basin or subbasin of California's Bulletin 118.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">groundwater basin</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00012408"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005021">
    <obo:IAO_0000115 xml:lang="en">A pipe or aqueduct that carries water over a distance.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">water pipeline</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005022">
    <obo:IAO_0000115 xml:lang="en">A facility that lifts or moves water with pumps.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">pumping station</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005023">
    <obo:IAO_0000115 xml:lang="en">Basins or works that put surface water into the ground to refill an aquifer.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">groundwater recharge facility</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005024">
    <obo:IAO_0000115 xml:lang="en">A structure that holds water back, such as a dam, a check dam or a detention basin.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">water retention structure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000074"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005025">
    <obo:IAO_0000115 xml:lang="en">A power plant that burns natural gas.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">natural gas-fired power plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002214"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005026">
    <obo:IAO_0000115 xml:lang="en">The building at a dam or penstock that holds the turbines and generators.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">hydroelectric powerhouse</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002214"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005027">
    <obo:IAO_0000115 xml:lang="en">A hydroelectric plant that pumps water uphill when power is cheap and releases it through turbines when power is needed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">pumped storage facility</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002214"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005028">
    <obo:IAO_0000115 xml:lang="en">A power plant that makes electricity from sunlight.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">solar power plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002214"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000867"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005029">
    <obo:IAO_0000115 xml:lang="en">A group of wind turbines that makes electricity.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">wind power plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002214"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005030">
    <obo:IAO_0000115 xml:lang="en">A high-voltage power line carrying electricity from plants to substations.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">electric transmission line</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000865"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005031">
    <obo:IAO_0000115 xml:lang="en">A facility where transmission lines meet and voltage is changed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">electrical substation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005032">
    <obo:IAO_0000115 xml:lang="en">A ranch, dairy, feedlot or other place where animals are raised.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">animal production site</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005005"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000078"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000627"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005033">
    <obo:IAO_0000115 xml:lang="en">A farm, orchard, vineyard or field where crops are grown.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">crop production site</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005005"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005034">
    <obo:IAO_0000115 xml:lang="en">Land protected by a conservation easement while its owner keeps title.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">conservation easement area</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001567"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005035">
    <obo:IAO_0000115 xml:lang="en">Land owned outright by an agency or organization for conservation, such as a reserve, refuge, park or wildlife area.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">fee-title conservation area</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001567"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000358"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005036">
    <obo:IAO_0000115 xml:lang="en">Ocean or bay waters protected for conservation, such as a marine protected area or sanctuary.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">marine conservation area</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001567"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000362"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005037">
    <obo:IAO_0000115 xml:lang="en">A conservation area made of parts held by fee title, easement or other protections together.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The explorer's label carries the source spelling "Multple".</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">conservation area under several protections</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001567"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005038">
    <obo:IAO_0000115 xml:lang="en">Open land kept undeveloped around or between towns.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">greenbelt</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005039">
    <obo:IAO_0000115 xml:lang="en">Land restored or protected so that credits can be sold to offset habitat loss elsewhere.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">mitigation bank</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001567"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005040">
    <obo:IAO_0000115 xml:lang="en">An overpass, underpass, culvert or bridge built or adapted so that animals can cross a road or railway.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">wildlife crossing structure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005041">
    <obo:IAO_0000115 xml:lang="en">A camera set off by motion or heat that photographs animals passing.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">camera trap</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005042">
    <obo:IAO_0000115 xml:lang="en">A research station or reserve that a university or agency runs for research and teaching, often with housing and labs, giving access to protected lands it may not own.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for UC Nature's field stations in national parks and forests and its reserves on private or leased land (#369).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">field station</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005043">
    <obo:IAO_0000115 xml:lang="en">A path for walking, cycling or riding, such as a regional trail like the Bay Area Ridge Trail or a preserve's trail network.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the regional trails the Midpen Vision Plan extends (#395).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">trail</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005007"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005044">
    <obo:IAO_0000115 xml:lang="en">A road in the state or federal highway system: an Interstate, a U.S. route or a California state route.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">highway</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005007"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005045">
    <obo:IAO_0000115 xml:lang="en">A road a county or city owns and maintains, outside the state and federal highway systems.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">local road</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005007"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005046">
    <obo:IAO_0000115 xml:lang="en">A rail line for freight or passenger trains.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">railway</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005007"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005047">
    <obo:IAO_0000115 xml:lang="en">Permanently protected and managed for biodiversity, with natural disturbance such as fire or flooding allowed to run its course.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0005008"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">GAP 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005048">
    <obo:IAO_0000115 xml:lang="en">Permanently protected and managed for biodiversity, with natural disturbance suppressed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0005008"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">GAP 2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005049">
    <obo:IAO_0000115 xml:lang="en">A facility that spawns and rears fish, mostly salmon and trout, for release into rivers and lakes to supply fisheries or to make up for spawning habitat a dam has blocked.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the CDFW hatcheries CalFish reports on: Feather River, Nimbus and Mokelumne River (#781).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">fish hatchery</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005032"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005050">
    <obo:IAO_0000115 xml:lang="en">A farm or nursery that grows native plants and their seed from local wild sources for habitat restoration, rather than for sale or food.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for Irvine Ranch Conservancy's Native Seed Farm in Irvine (#793).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">native plant nursery</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005051">
    <obo:IAO_0000115 xml:lang="en">An area of ocean, estuary or shoreline that a conservation plan marks as a priority for protecting marine biodiversity, without itself being protected, such as a portfolio conservation area of a marine ecoregional assessment.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the 55 portfolio conservation areas of The Nature Conservancy's 2006 Northern California Marine Ecoregional Assessment (#919).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">marine conservation priority area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005052">
    <obo:IAO_0000115 xml:lang="en">A site that BirdLife International's Important Bird Areas program, run in the United States by the National Audubon Society, identifies as essential for birds because it holds species of conservation concern, range-restricted species or large concentrations of birds, without itself being protected.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the grassland Important Bird Areas of California Partners in Flight's Grassland Bird Conservation Plan (#976).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">important bird area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005053">
    <obo:IAO_0000115 xml:lang="en">A facility on a natural gas transmission pipeline that raises the gas pressure to keep it moving along the line. Example: San Diego Gas &amp; Electric's Moreno Compressor Station in Moreno Valley, which boosts the gas supply into San Diego County.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">natural gas compressor station</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005054">
    <obo:IAO_0000115 xml:lang="en">A named natural feature of the land surface, such as a range of hills, a ridge or a valley, that a conservation plan treats as an area to protect or work in, without itself being protected. Example: the Dunnigan Hills of Yolo County, where the Yolo HCP/NCCP protects grassland for California tiger salamander.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the Dunnigan Hills, named by the Yolo HCP/NCCP (#1067).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">named landform</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001886"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005055">
    <obo:IAO_0000115 xml:lang="en">A facility that treats raw water from reservoirs, rivers or wells to drinking water standards before it enters a distribution system. Example: the San Francisco Public Utilities Commission's Sunol Valley Water Treatment Plant, which treats water from San Antonio and Calaveras reservoirs.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the Sunol Valley Water Treatment Plant, named by the Alameda Watershed Management Plan (#1115).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">water treatment plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005056">
    <obo:IAO_0000115 xml:lang="en">A site where solid waste is buried in the ground, usually in lined cells that are covered and capped when full. Example: the Sanitation Districts of Los Angeles County's Puente Hills Landfill, which closed in 2013.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the Puente Hills Landfill, whose conditional use permit created the Puente Hills Habitat Preservation Authority (#1191).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">landfill</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005009"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005057">
    <obo:IAO_0000115 xml:lang="en">A structure that carries a road, trail or railway over a creek, river or other obstacle. Example: the Pope-Chaucer Bridge over San Francisquito Creek between Menlo Park and Palo Alto.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the two San Francisquito Creek bridges whose replacement is part of the SFCJPA's Reach 2 project (#1276).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">bridge</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005007"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005058">
    <obo:IAO_0000115 xml:lang="en">An area that a federal or state recovery plan designates as essential to the recovery of listed species, such as a core area whose habitat the plan says to protect, without itself being protected. Example: the Mather Core Recovery Area of the 2005 Recovery Plan for Vernal Pool Ecosystems of California and Southern Oregon, where the South Sacramento HCP must mitigate vernal pool losses.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the vernal pool core recovery areas named by the South Sacramento HCP (#1390).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">species recovery area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005059">
    <obo:IAO_0000115 xml:lang="en">A facility that treats sewage and other wastewater before it is discharged or reused, for example as recycled water for irrigation. Example: the City of Santa Rosa's Laguna Treatment Plant, on the floodplain of the Laguna de Santa Rosa.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the Laguna Treatment Plant, beside two restoration concepts of the Restoration Plan for the Laguna de Santa Rosa (#1643).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">wastewater treatment plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005100">
    <obo:IAO_0000115 xml:lang="en">Links a place to one of the infrastructure type classes it belongs to. The explorer's way of stating the place's class.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">has infrastructure type</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005101"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005101">
    <obo:IAO_0000115 xml:lang="en">The reverse of has infrastructure type.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is infrastructure type of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005100"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005102">
    <obo:IAO_0000115 xml:lang="en">The organization holding legal title to the place.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">owned by</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005103"/>
    <iconbase:ICON_0000001>ISO 19115-1: CI_RoleCode owner</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005103">
    <obo:IAO_0000115 xml:lang="en">The reverse of owned by.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">owns</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005102"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005104">
    <obo:IAO_0000115 xml:lang="en">The organization that operates or manages the place, whether or not it owns it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">managed by</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005105"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005105">
    <obo:IAO_0000115 xml:lang="en">The reverse of managed by.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">manages</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005104"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005106">
    <obo:IAO_0000115 xml:lang="en">Water flows from this place to the other, directly or through places between: Lake Berryessa is upstream of Monticello Dam.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is upstream of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005107">
    <obo:IAO_0000115 xml:lang="en">The reverse of is upstream of.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is downstream of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005106"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005108">
    <obo:IAO_0000115 xml:lang="en">Two places share a boundary. Symmetric, unlike the Relation Ontology's adjacent to, which it narrows.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is adjacent to</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005109">
    <obo:IAO_0000115 xml:lang="en">The place supports a population of the taxon.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is habitat for</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005110"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005110">
    <obo:IAO_0000115 xml:lang="en">The taxon lives in or uses the place: the reverse of is habitat for.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is found in</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005109"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002303"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005111">
    <obo:IAO_0000115 xml:lang="en">The structure was built or adapted so that the taxon can get past a barrier, as a wildlife crossing is built for the animals it lets cross a road. Unlike is habitat for, it says nothing about the taxon living there.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">built for</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005112"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005112">
    <obo:IAO_0000115 xml:lang="en">The taxon has a structure built or adapted to let it get past a barrier: the reverse of built for.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">has crossing</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005111"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005113">
    <obo:IAO_0000115 xml:lang="en">The sensor or array was set up to watch the taxon, as a camera trap study of fishers monitors the fisher. It says nothing about whether the taxon was found.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">monitors</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005114">
    <obo:IAO_0000115 xml:lang="en">The taxon is watched by a sensor or array set up for it: the reverse of monitors.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">monitored by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005115">
    <obo:IAO_0000115 xml:lang="en">The sensor or array recorded the taxon, as a camera trap photographs a bobcat. Unlike is habitat for, it says only that the taxon passed the sensor.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">detected</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005116"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005116">
    <obo:IAO_0000115 xml:lang="en">The taxon was recorded by a sensor or array: the reverse of detected.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0011000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">detected by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005115"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005117">
    <obo:IAO_0000115 xml:lang="en">The structure carries animals under or over the road or railway, as a wildlife crossing structure crosses the highway it passes beneath.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">crosses</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005007"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005118"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005118">
    <obo:IAO_0000115 xml:lang="en">The road or railway has a structure that carries animals under or over it: the reverse of crosses.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005007"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">crossed by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005117"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005119">
    <obo:IAO_0000115 xml:lang="en">Water flows between the two places in either direction, as through an intertie that pumps both ways: the Cross Valley Canal exchanges water with the California Aqueduct. Unlike is upstream of it does not chain, so what lies upstream of one is not taken to lie upstream of the other.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">exchanges water with</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005120">
    <obo:IAO_0000115 xml:lang="en">Some of this place's water leaves for the other at one point, as a river spills over a weir into a flood bypass, while the place as a whole may lie downstream of the other too: the Sacramento River spills into the Yolo Bypass, which rejoins it lower down. Unlike is upstream of it does not chain, so the river's tributaries are not taken to lie upstream of the bypass.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">spills into</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005121"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005121">
    <obo:IAO_0000115 xml:lang="en">The reverse of spills into.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">receives spill from</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005120"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005122">
    <obo:IAO_0000115 xml:lang="en">The GAP status of the place's lands, as the 30x30 Conserved Areas rate them; a place with lands at both levels has both.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">has GAP status</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005008"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005123"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005123">
    <obo:IAO_0000115 xml:lang="en">The reverse of has GAP status.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005008"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">is GAP status of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0005122"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005124">
    <obo:IAO_0000115 xml:lang="en">An area that the California Native Plant Society's Important Plant Areas Initiative identifies as among the most important places in the state for rare plants and rare vegetation types, without itself being protected. Example: a Tier 1 area of the Northwestern California ecoregion around the Mendocino pygmy forest, home to 37 California Rare Plant Rank 1B species.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the statewide draft Important Plant Areas that CNPS published for review in 2026 (#1210).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">important plant area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005125">
    <obo:IAO_0000115 xml:lang="en">A region that the United States Congress designates for its nationally important natural, cultural, and historic resources, managed through partnerships led by a local coordinating entity under a management plan approved by the Secretary of the Interior, without federal ownership or land use regulation. Example: the Sacramento-San Joaquin Delta National Heritage Area, designated in 2019, whose local coordinating entity is the Delta Protection Commission.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the Sacramento-San Joaquin Delta National Heritage Area (#1677).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">national heritage area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0005002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0005200">
    <obo:IAO_0000115 xml:lang="en">How much the place holds or delivers, written with its unit: a reservoir's storage in acre-feet, a plant's output in megawatts.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:label xml:lang="en">capacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011000">
    <obo:IAO_0000115 xml:lang="en">A species or a group of species that records concern, identified by its NatureServe element where it has one. Groups (salmonids, bats) are taxa at a higher rank or informal groupings of them.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">taxon</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/infrastructure.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">Places and structures on the landscape that conservation works on or around: waters (blue), conservation lands (green), water works, energy, food production and sensors. Covers their types, ownership and management, and how they lie relative to one another (upstream, adjacent, intersecting).</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/cob.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
    <dcterms:references rdf:resource="http://www.opengis.net/ont/geosparql"/>
    <dcterms:title xml:lang="en">ICON Infrastructure ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Reused: Environment Ontology. Built on: Core Ontology for Biology and Biomedicine, Environment Ontology, Information Artifact Ontology, Ontology for Biomedical Investigations, Relation Ontology. Mapped to: Environment Ontology, GeoSPARQL, Relation Ontology.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/core.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon/releases/2026-11-21/infrastructure.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
