# ICON Infrastructure ontology
# Built by `ioc-ontologies` from ontology/src/infrastructure.terms; edit that file, not this one.
# Guide: ontology/guides/infrastructure.md
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix COB: <http://purl.obolibrary.org/obo/COB_> .
@prefix ENVO: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix PCO: <http://purl.obolibrary.org/obo/PCO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ENVO:00002215 a owl:Class ;
    rdfs:label "geothermal power plant"@en ;
    IAO:0000115 "A geothermal power plant is a power plant which uses heat generated by the decay of radioactive isotopes in the Earth's mantle and crust as well as primordial heat left over from the formation of the Earth to drive its generators."@en ;
    rdfs:subClassOf ENVO:00002214 .

IAO:0000115 a owl:AnnotationProperty ;
    rdfs:label "definition" .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:references a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

oboInOwl:hasDbXref a owl:AnnotationProperty ;
    rdfs:label "database_cross_reference" .

oboInOwl:hasExactSynonym a owl:AnnotationProperty ;
    rdfs:label "has_exact_synonym" .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

icon:0000001 a owl:AnnotationProperty ;
    rdfs:label "crosswalk"@en ;
    IAO:0000115 "The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as \"EML 2.2: dataset/title\"."@en ;
    rdfs:isDefinedBy iconbase:core.owl .

icon:0005001 a owl:Class ;
    rdfs:label "blue infrastructure"@en ;
    IAO:0000115 "A body of water: a river or stream, a lake or pond, a dry lake or playa, a wetland, an estuary or the ocean."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ENVO:00000023 ENVO:01000617 ENVO:00000277 ENVO:00000043 ENVO:00000045 ENVO:00001999 ) ] .

icon:0005025 a owl:Class ;
    rdfs:label "natural gas-fired power plant"@en ;
    IAO:0000115 "A power plant that burns natural gas."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00002214,
        icon:0005004 .

icon:0005026 a owl:Class ;
    rdfs:label "hydroelectric powerhouse"@en ;
    IAO:0000115 "The building at a dam or penstock that holds the turbines and generators."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00002214,
        icon:0005004 .

icon:0005027 a owl:Class ;
    rdfs:label "pumped storage facility"@en ;
    IAO:0000115 "A hydroelectric plant that pumps water uphill when power is cheap and releases it through turbines when power is needed."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00002214,
        icon:0005004 .

icon:0005028 a owl:Class ;
    rdfs:label "solar power plant"@en ;
    IAO:0000115 "A power plant that makes electricity from sunlight."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00002214,
        icon:0005004 ;
    skos:closeMatch ENVO:01000867 .

icon:0005029 a owl:Class ;
    rdfs:label "wind power plant"@en ;
    IAO:0000115 "A group of wind turbines that makes electricity."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00002214,
        icon:0005004 .

icon:0005041 a owl:Class ;
    rdfs:label "camera trap"@en ;
    IAO:0000115 "A camera set off by motion or heat that photographs animals passing."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf COB:0001300,
        icon:0005006 .

icon:0005042 a owl:Class ;
    rdfs:label "field station"@en ;
    IAO:0000115 "A research station or reserve that a university or agency runs for research and teaching, often with housing and labs, giving access to protected lands it may not own."@en ;
    rdfs:comment "Added for UC Nature's field stations in national parks and forests and its reserves on private or leased land (#369)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005047 a owl:NamedIndividual,
        icon:0005008 ;
    rdfs:label "GAP 1"@en ;
    IAO:0000115 "Permanently protected and managed for biodiversity, with natural disturbance such as fire or flooding allowed to run its course."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl .

icon:0005048 a owl:NamedIndividual,
        icon:0005008 ;
    rdfs:label "GAP 2"@en ;
    IAO:0000115 "Permanently protected and managed for biodiversity, with natural disturbance suppressed."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl .

icon:0005049 a owl:Class ;
    rdfs:label "fish hatchery"@en ;
    IAO:0000115 "A facility that spawns and rears fish, mostly salmon and trout, for release into rivers and lakes to supply fisheries or to make up for spawning habitat a dam has blocked."@en ;
    rdfs:comment "Added for the CDFW hatcheries CalFish reports on: Feather River, Nimbus and Mokelumne River (#781)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005032 .

icon:0005050 a owl:Class ;
    rdfs:label "native plant nursery"@en ;
    IAO:0000115 "A farm or nursery that grows native plants and their seed from local wild sources for habitat restoration, rather than for sale or food."@en ;
    rdfs:comment "Added for Irvine Ranch Conservancy's Native Seed Farm in Irvine (#793)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005053 a owl:Class ;
    rdfs:label "natural gas compressor station"@en ;
    IAO:0000115 "A facility on a natural gas transmission pipeline that raises the gas pressure to keep it moving along the line. Example: San Diego Gas & Electric's Moreno Compressor Station in Moreno Valley, which boosts the gas supply into San Diego County."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005004 .

icon:0005054 a owl:Class ;
    rdfs:label "named landform"@en ;
    IAO:0000115 "A named natural feature of the land surface, such as a range of hills, a ridge or a valley, that a conservation plan treats as an area to protect or work in, without itself being protected. Example: the Dunnigan Hills of Yolo County, where the Yolo HCP/NCCP protects grassland for California tiger salamander."@en ;
    rdfs:comment "Added for the Dunnigan Hills, named by the Yolo HCP/NCCP (#1067)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:01001886,
        icon:0005002 .

icon:0005056 a owl:Class ;
    rdfs:label "landfill"@en ;
    IAO:0000115 "A site where solid waste is buried in the ground, usually in lined cells that are covered and capped when full. Example: the Sanitation Districts of Los Angeles County's Puente Hills Landfill, which closed in 2013."@en ;
    rdfs:comment "Added for the Puente Hills Landfill, whose conditional use permit created the Puente Hills Habitat Preservation Authority (#1191)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005009 .

icon:0005058 a owl:Class ;
    rdfs:label "species recovery area"@en ;
    IAO:0000115 "An area that a federal or state recovery plan designates as essential to the recovery of listed species, such as a core area whose habitat the plan says to protect, without itself being protected. Example: the Mather Core Recovery Area of the 2005 Recovery Plan for Vernal Pool Ecosystems of California and Southern Oregon, where the South Sacramento HCP must mitigate vernal pool losses."@en ;
    rdfs:comment "Added for the vernal pool core recovery areas named by the South Sacramento HCP (#1390)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005059 a owl:Class ;
    rdfs:label "wastewater treatment plant"@en ;
    IAO:0000115 "A facility that treats sewage and other wastewater before it is discharged or reused, for example as recycled water for irrigation. Example: the City of Santa Rosa's Laguna Treatment Plant, on the floodplain of the Laguna de Santa Rosa."@en ;
    rdfs:comment "Added for the Laguna Treatment Plant, beside two restoration concepts of the Restoration Plan for the Laguna de Santa Rosa (#1643)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005003 .

icon:0005108 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is adjacent to"@en ;
    IAO:0000115 "Two places share a boundary. Symmetric, unlike the Relation Ontology's adjacent to, which it narrows."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    rdfs:subPropertyOf RO:0002220 .

icon:0005119 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "exchanges water with"@en ;
    IAO:0000115 "Water flows between the two places in either direction, as through an intertie that pumps both ways: the Cross Valley Canal exchanges water with the California Aqueduct. Unlike is upstream of it does not chain, so what lies upstream of one is not taken to lie upstream of the other."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 .

icon:0005125 a owl:Class ;
    rdfs:label "national heritage area"@en ;
    IAO:0000115 "A region that the United States Congress designates for its nationally important natural, cultural, and historic resources, managed through partnerships led by a local coordinating entity under a management plan approved by the Secretary of the Interior, without federal ownership or land use regulation. Example: the Sacramento-San Joaquin Delta National Heritage Area, designated in 2019, whose local coordinating entity is the Delta Protection Commission."@en ;
    rdfs:comment "Added for the Sacramento-San Joaquin Delta National Heritage Area (#1677)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005200 a owl:DatatypeProperty ;
    rdfs:label "capacity"@en ;
    IAO:0000115 "How much the place holds or delivers, written with its unit: a reservoir's storage in acre-feet, a plant's output in megawatts."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range xsd:string .

BFO:0000001 a owl:Class ;
    rdfs:label "entity"@en .

BFO:0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf BFO:0000040 .

BFO:0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    IAO:0000115 "b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])"@en ;
    rdfs:subClassOf BFO:0000002 .

COB:0000026 a owl:Class ;
    rdfs:label "processed material entity"@en ;
    IAO:0000115 "A material entity processed by human activity with an intent to produce it."@en ;
    rdfs:subClassOf BFO:0000040 .

COB:0001300 a owl:Class ;
    rdfs:label "device"@en ;
    IAO:0000115 "A processed material entity which is designed to be capable of a process."@en ;
    rdfs:subClassOf COB:0000026 .

ENVO:00000000 a owl:Class ;
    rdfs:label "geographic feature"@en ;
    IAO:0000115 "An astrononmical body part which delimited by physical discontinuities with its surroundings."@en ;
    rdfs:subClassOf ENVO:01000813 .

ENVO:00000012 a owl:Class ;
    rdfs:label "hydrographic feature"@en ;
    IAO:0000115 "A geographical feature associated with water."@en ;
    rdfs:subClassOf ENVO:00000000,
        RO:0002577 .

ENVO:00000014 a owl:Class ;
    rdfs:label "canal"@en ;
    IAO:0000115 "Artificial watercourse with no flow or a controlled flow used for navigation, drainage or irrigation."@en ;
    rdfs:subClassOf ENVO:00000029 .

ENVO:00000020 a owl:Class ;
    rdfs:label "lake"@en ;
    IAO:0000115 "A body of water or other liquid of considerable size contained in a depression on a landmass."@en ;
    rdfs:subClassOf ENVO:01000617 .

ENVO:00000023 a owl:Class ;
    rdfs:label "stream"@en ;
    IAO:0000115 "A watercourse which is linear and flows across the solid portion of a planetary surface."@en ;
    rdfs:subClassOf ENVO:00000029 .

ENVO:00000025 a owl:Class ;
    rdfs:label "reservoir"@en ;
    IAO:0000115 "An artificial body of water, often contained by a dam, constructed for the purpose of water storage."@en ;
    rdfs:subClassOf ENVO:00000377 .

ENVO:00000043 a owl:Class ;
    rdfs:label "wetland area"@en ;
    IAO:0000115 "An vegetated area which overlaps a wetland ecosystem."@en ;
    rdfs:subClassOf ENVO:01001305 .

ENVO:00000045 a owl:Class ;
    rdfs:label "estuary"@en ;
    IAO:0000115 "A semi-enclosed coastal body of water with one or more rivers or streams flowing into it, and with a free connection to the open sea."@en ;
    rdfs:subClassOf ENVO:00000063 .

ENVO:00000073 a owl:Class ;
    rdfs:label "building"@en ;
    IAO:0000115 "A permanent walled and roofed construction."@en ;
    rdfs:subClassOf ENVO:00000070 .

ENVO:00000178 a owl:Class ;
    rdfs:label "levee"@en ;
    IAO:0000115 "An artificial slope or wall, usually earthen, which parallels the course of a river, built for the purpose of containing the river."@en ;
    rdfs:subClassOf ENVO:00000012,
        ENVO:00000070,
        ENVO:00002000 .

ENVO:00000191 a owl:Class ;
    rdfs:label "solid astronomical body part"@en ;
    IAO:0000115 "A part of an astronomical body which is primarily composed of solid material."@en ;
    rdfs:subClassOf ENVO:01001784 .

ENVO:00000256 a owl:Class ;
    rdfs:label "floodway"@en ;
    IAO:0000115 "The stream channel and adjacent areas that carry flood flows in a flood plain."@en ;
    rdfs:subClassOf ENVO:00000309,
        ENVO:01001884 .

ENVO:00000277 a owl:Class ;
    rdfs:label "dry lake"@en ;
    IAO:0000115 "A lake that has either permanently or temporally lost its water."@en ;
    rdfs:subClassOf ENVO:00000309,
        ENVO:01001884 .

ENVO:00000377 a owl:Class ;
    rdfs:label "artificial lake"@en ;
    IAO:0000115 "A lake purposefully constructed."@en ;
    rdfs:subClassOf ENVO:00000020,
        ENVO:00000070 .

ENVO:00000535 a owl:Class ;
    rdfs:label "weir"@en ;
    IAO:0000115 "A low obstruction built across the path of s stream to raise its level."@en ;
    rdfs:subClassOf ENVO:00000074 .

ENVO:00001999 a owl:Class ;
    rdfs:label "marine water body"@en ;
    IAO:0000115 "A lentic water body which is composed primarily of marine water."@en ;
    rdfs:subClassOf ENVO:01000617 .

ENVO:00002000 a owl:Class ;
    rdfs:label "slope"@en ;
    IAO:0000115 "A solid astronomical body part which is part of the planetary surface between the peak of an elevation or the bottom of a depression and relatively flat surrounding land."@en ;
    rdfs:subClassOf ENVO:01001886 .

ENVO:00003861 a owl:Class ;
    rdfs:label "industrial building"@en ;
    IAO:0000115 "An industrial building is a building within which goods are produced and, optionally, stored or within which services are rendered."@en ;
    rdfs:subClassOf ENVO:00000073 .

ENVO:01000254 a owl:Class ;
    rdfs:label "environmental system"@en ;
    IAO:0000115 "A system which has the disposition to environ one or more material entities."@en ;
    rdfs:subClassOf RO:0002577 .

ENVO:01000408 a owl:Class ;
    rdfs:label "environmental zone"@en ;
    IAO:0000115 "A site which has its extent determined by the presence or influence of one or more components of an environmental system or the processes occurring therein."@en ;
    rdfs:subClassOf BFO:0000024 .

ENVO:01000467 a owl:Class ;
    rdfs:label "constructed barrier"@en ;
    IAO:0000115 "A constructed barrier is a freestanding wall, berm, or fence built to limit movement of entities across a boundary."@en ;
    rdfs:subClassOf ENVO:00000070 .

ENVO:01000618 a owl:Class ;
    rdfs:label "lotic water body"@en ;
    IAO:0000115 "A lotic water body is a water body in which the accumulated water, in its totality, is flowing."@en ;
    rdfs:subClassOf ENVO:00000063 .

ENVO:01000685 a owl:Class ;
    rdfs:label "water mass"@en ;
    IAO:0000115 "A mass of water."@en ;
    rdfs:subClassOf ENVO:01001476 .

ENVO:01000930 a owl:Class ;
    rdfs:label "ecological corridor"@en ;
    IAO:0000115 "An ecosystem which bridges two or more adjoining ecosystems and through which organisms may move or propagate."@en ;
    rdfs:subClassOf ENVO:01001110 .

ENVO:01001110 a owl:Class ;
    rdfs:label "ecosystem"@en ;
    IAO:0000115 "An environmental system which includes both living and non-living components."@en ;
    rdfs:subClassOf ENVO:01000254 .

ENVO:01001199 a owl:Class ;
    rdfs:label "terrestrial environmental zone"@en ;
    IAO:0000115 "An environmental zone which is bounded by material parts of a land mass or the atmosphere or space adjacent to it."@en ;
    rdfs:subClassOf ENVO:01000408,
        ENVO:01000813 .

ENVO:01001305 a owl:Class ;
    rdfs:label "vegetated area"@en ;
    IAO:0000115 "A vegetated area is a geographic feature which has ground cover dominated by plant communities."@en ;
    rdfs:subClassOf ENVO:01001199 .

ENVO:01001476 a owl:Class ;
    rdfs:label "body of liquid"@en ;
    IAO:0000115 "A liquid astronomical body part which is continuous and is delimited by physical discontinuities or non-liquid boundaries."@en ;
    rdfs:subClassOf ENVO:01001477 .

ENVO:01001477 a owl:Class ;
    rdfs:label "liquid astronomical body part"@en ;
    IAO:0000115 "A part of an astronomical body which is primarily composed of liquid material."@en ;
    rdfs:subClassOf ENVO:01001479,
        ENVO:01001784 .

ENVO:01001479 a owl:Class ;
    rdfs:label "fluid astronomical body part"@en ;
    IAO:0000115 "A part of an astronomical body which is primarily composed of fluid."@en ;
    rdfs:subClassOf ENVO:01000813 .

ENVO:01001813 a owl:Class ;
    rdfs:label "construction"@en ;
    IAO:0000115 "A material entity which has been assembled through the intentional, instinctual, or deliberately programmed efforts of an organism or machine."@en ;
    rdfs:subClassOf BFO:0000040 .

ENVO:01003020 a owl:Class ;
    rdfs:label "fiat part of an astronomical object"@en ;
    IAO:0000115 "A part of an environmental system whose boundaries are determined by fiat."@en ;
    rdfs:subClassOf BFO:0000024 .

IAO:0000030 a owl:Class ;
    rdfs:label "information content entity"@en ;
    IAO:0000115 "A generically dependent continuant that is about some thing."@en ;
    rdfs:subClassOf BFO:0000031 .

PCO:0000000 a owl:Class ;
    rdfs:label "collection of organisms"@en ;
    IAO:0000115 "A material entity that consists of two or more organisms, viruses, or viroids."@en ;
    rdfs:subClassOf BFO:0000027,
        PCO:0000031 .

PCO:0000031 a owl:Class ;
    rdfs:label "organismal entity"@en ;
    IAO:0000115 "A material entity that is one or more organisms, viruses or viroids."@en ;
    rdfs:subClassOf BFO:0000040 .

PCO:0000059 a owl:Class ;
    rdfs:label "taxon as collection of organisms"@en ;
    IAO:0000115 "A collection of organisms that has as members every organism of a taxon and no organisms of any other equal or higher ranked taxon. The taxon may be at any level. If the taxon is species, then this is the same as the class species as a collection of organisms. When defining a taxon, it is generally understood that members include both living organisms and dead organisms that are known through specimens or observations."@en ;
    rdfs:subClassOf PCO:0000000 .

RO:0002163 a owl:ObjectProperty ;
    rdfs:label "spatially disjoint from"@en ;
    IAO:0000115 "A is spatially_disjoint_from B if and only if they have no parts in common"@en ;
    rdfs:subPropertyOf RO:0002323 .

RO:0002220 a owl:ObjectProperty ;
    rdfs:label "adjacent to"@en ;
    IAO:0000115 "x adjacent to y if and only if x and y share a boundary."@en ;
    rdfs:subPropertyOf RO:0002163 .

RO:0002323 a owl:ObjectProperty ;
    rdfs:label "mereotopologically related to"@en ;
    IAO:0000115 "A mereological relationship or a topological relationship"@en .

icon:0000012 a owl:Class ;
    rdfs:label "place"@en ;
    IAO:0000115 "A part of the landscape or a structure in it that records can be located at, worked on or bounded by: a river, a reserve, a dam, a crossing structure."@en ;
    rdfs:isDefinedBy iconbase:core.owl ;
    rdfs:subClassOf BFO:0000004 .

icon:0005006 a owl:Class ;
    rdfs:label "sensor infrastructure"@en ;
    IAO:0000115 "A device placed in the landscape to record what passes or happens there."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 .

icon:0005009 a owl:Class ;
    rdfs:label "waste infrastructure"@en ;
    IAO:0000115 "A facility that receives, stores or disposes of solid waste, such as a landfill."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 .

icon:0005020 a owl:Class ;
    rdfs:label "groundwater basin"@en ;
    IAO:0000115 "An aquifer or group of aquifers managed as a unit, such as a basin or subbasin of California's Bulletin 118."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005003 ;
    skos:closeMatch ENVO:00012408 .

icon:0005021 a owl:Class ;
    rdfs:label "water pipeline"@en ;
    IAO:0000115 "A pipe or aqueduct that carries water over a distance."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005003 .

icon:0005022 a owl:Class ;
    rdfs:label "pumping station"@en ;
    IAO:0000115 "A facility that lifts or moves water with pumps."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005003 .

icon:0005023 a owl:Class ;
    rdfs:label "groundwater recharge facility"@en ;
    IAO:0000115 "Basins or works that put surface water into the ground to refill an aquifer."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005003 .

icon:0005024 a owl:Class ;
    rdfs:label "water retention structure"@en ;
    IAO:0000115 "A structure that holds water back, such as a dam, a check dam or a detention basin."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005003 ;
    skos:closeMatch ENVO:00000074 .

icon:0005030 a owl:Class ;
    rdfs:label "electric transmission line"@en ;
    IAO:0000115 "A high-voltage power line carrying electricity from plants to substations."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005004 ;
    skos:closeMatch ENVO:01000865 .

icon:0005031 a owl:Class ;
    rdfs:label "electrical substation"@en ;
    IAO:0000115 "A facility where transmission lines meet and voltage is changed."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005004 .

icon:0005033 a owl:Class ;
    rdfs:label "crop production site"@en ;
    IAO:0000115 "A farm, orchard, vineyard or field where crops are grown."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005005 ;
    skos:closeMatch ENVO:00000114 .

icon:0005034 a owl:Class ;
    rdfs:label "conservation easement area"@en ;
    IAO:0000115 "Land protected by a conservation easement while its owner keeps title."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:01001567,
        icon:0005002 .

icon:0005035 a owl:Class ;
    rdfs:label "fee-title conservation area"@en ;
    IAO:0000115 "Land owned outright by an agency or organization for conservation, such as a reserve, refuge, park or wildlife area."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:01001567,
        icon:0005002 ;
    skos:closeMatch ENVO:00000358 .

icon:0005036 a owl:Class ;
    rdfs:label "marine conservation area"@en ;
    IAO:0000115 "Ocean or bay waters protected for conservation, such as a marine protected area or sanctuary."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:01001567,
        icon:0005002 ;
    skos:closeMatch ENVO:00000362 .

icon:0005037 a owl:Class ;
    rdfs:label "conservation area under several protections"@en ;
    IAO:0000115 "A conservation area made of parts held by fee title, easement or other protections together."@en ;
    rdfs:comment "The explorer's label carries the source spelling \"Multple\"."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:01001567,
        icon:0005002 .

icon:0005038 a owl:Class ;
    rdfs:label "greenbelt"@en ;
    IAO:0000115 "Open land kept undeveloped around or between towns."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005039 a owl:Class ;
    rdfs:label "mitigation bank"@en ;
    IAO:0000115 "Land restored or protected so that credits can be sold to offset habitat loss elsewhere."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:01001567,
        icon:0005002 .

icon:0005040 a owl:Class ;
    rdfs:label "wildlife crossing structure"@en ;
    IAO:0000115 "An overpass, underpass, culvert or bridge built or adapted so that animals can cross a road or railway."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005002 .

icon:0005043 a owl:Class ;
    rdfs:label "trail"@en ;
    IAO:0000115 "A path for walking, cycling or riding, such as a regional trail like the Bay Area Ridge Trail or a preserve's trail network."@en ;
    rdfs:comment "Added for the regional trails the Midpen Vision Plan extends (#395)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005007 .

icon:0005044 a owl:Class ;
    rdfs:label "highway"@en ;
    IAO:0000115 "A road in the state or federal highway system: an Interstate, a U.S. route or a California state route."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005007 .

icon:0005045 a owl:Class ;
    rdfs:label "local road"@en ;
    IAO:0000115 "A road a county or city owns and maintains, outside the state and federal highway systems."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005007 .

icon:0005046 a owl:Class ;
    rdfs:label "railway"@en ;
    IAO:0000115 "A rail line for freight or passenger trains."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005007 .

icon:0005051 a owl:Class ;
    rdfs:label "marine conservation priority area"@en ;
    IAO:0000115 "An area of ocean, estuary or shoreline that a conservation plan marks as a priority for protecting marine biodiversity, without itself being protected, such as a portfolio conservation area of a marine ecoregional assessment."@en ;
    rdfs:comment "Added for the 55 portfolio conservation areas of The Nature Conservancy's 2006 Northern California Marine Ecoregional Assessment (#919)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005052 a owl:Class ;
    rdfs:label "important bird area"@en ;
    IAO:0000115 "A site that BirdLife International's Important Bird Areas program, run in the United States by the National Audubon Society, identifies as essential for birds because it holds species of conservation concern, range-restricted species or large concentrations of birds, without itself being protected."@en ;
    rdfs:comment "Added for the grassland Important Bird Areas of California Partners in Flight's Grassland Bird Conservation Plan (#976)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

icon:0005055 a owl:Class ;
    rdfs:label "water treatment plant"@en ;
    IAO:0000115 "A facility that treats raw water from reservoirs, rivers or wells to drinking water standards before it enters a distribution system. Example: the San Francisco Public Utilities Commission's Sunol Valley Water Treatment Plant, which treats water from San Antonio and Calaveras reservoirs."@en ;
    rdfs:comment "Added for the Sunol Valley Water Treatment Plant, named by the Alameda Watershed Management Plan (#1115)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005003 .

icon:0005057 a owl:Class ;
    rdfs:label "bridge"@en ;
    IAO:0000115 "A structure that carries a road, trail or railway over a creek, river or other obstacle. Example: the Pope-Chaucer Bridge over San Francisquito Creek between Menlo Park and Palo Alto."@en ;
    rdfs:comment "Added for the two San Francisquito Creek bridges whose replacement is part of the SFCJPA's Reach 2 project (#1276)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf ENVO:00000070,
        icon:0005007 .

icon:0005100 a owl:ObjectProperty ;
    rdfs:label "has infrastructure type"@en ;
    IAO:0000115 "Links a place to one of the infrastructure type classes it belongs to. The explorer's way of stating the place's class."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    owl:inverseOf icon:0005101 .

icon:0005101 a owl:ObjectProperty ;
    rdfs:label "is infrastructure type of"@en ;
    IAO:0000115 "The reverse of has infrastructure type."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005100 .

icon:0005102 a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    IAO:0000115 "The organization holding legal title to the place."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range OBI:0000245 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0005103 ;
    icon:0000001 "ISO 19115-1: CI_RoleCode owner" .

icon:0005103 a owl:ObjectProperty ;
    rdfs:label "owns"@en ;
    IAO:0000115 "The reverse of owned by."@en ;
    rdfs:domain OBI:0000245 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0005102 .

icon:0005104 a owl:ObjectProperty ;
    rdfs:label "managed by"@en ;
    IAO:0000115 "The organization that operates or manages the place, whether or not it owns it."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range OBI:0000245 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0005105 .

icon:0005105 a owl:ObjectProperty ;
    rdfs:label "manages"@en ;
    IAO:0000115 "The reverse of managed by."@en ;
    rdfs:domain OBI:0000245 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0005104 .

icon:0005106 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is upstream of"@en ;
    IAO:0000115 "Water flows from this place to the other, directly or through places between: Lake Berryessa is upstream of Monticello Dam."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005107 .

icon:0005107 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is downstream of"@en ;
    IAO:0000115 "The reverse of is upstream of."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005106 .

icon:0005109 a owl:ObjectProperty ;
    rdfs:label "is habitat for"@en ;
    IAO:0000115 "The place supports a population of the taxon."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0011000 ;
    owl:inverseOf icon:0005110 .

icon:0005110 a owl:ObjectProperty ;
    rdfs:label "is found in"@en ;
    IAO:0000115 "The taxon lives in or uses the place: the reverse of is habitat for."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005109 ;
    skos:closeMatch RO:0002303 .

icon:0005111 a owl:ObjectProperty ;
    rdfs:label "built for"@en ;
    IAO:0000115 "The structure was built or adapted so that the taxon can get past a barrier, as a wildlife crossing is built for the animals it lets cross a road. Unlike is habitat for, it says nothing about the taxon living there."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0011000 ;
    owl:inverseOf icon:0005112 .

icon:0005112 a owl:ObjectProperty ;
    rdfs:label "has crossing"@en ;
    IAO:0000115 "The taxon has a structure built or adapted to let it get past a barrier: the reverse of built for."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005111 .

icon:0005113 a owl:ObjectProperty ;
    rdfs:label "monitors"@en ;
    IAO:0000115 "The sensor or array was set up to watch the taxon, as a camera trap study of fishers monitors the fisher. It says nothing about whether the taxon was found."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0011000 ;
    owl:inverseOf icon:0005114 .

icon:0005114 a owl:ObjectProperty ;
    rdfs:label "monitored by"@en ;
    IAO:0000115 "The taxon is watched by a sensor or array set up for it: the reverse of monitors."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005113 .

icon:0005115 a owl:ObjectProperty ;
    rdfs:label "detected"@en ;
    IAO:0000115 "The sensor or array recorded the taxon, as a camera trap photographs a bobcat. Unlike is habitat for, it says only that the taxon passed the sensor."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0011000 ;
    owl:inverseOf icon:0005116 .

icon:0005116 a owl:ObjectProperty ;
    rdfs:label "detected by"@en ;
    IAO:0000115 "The taxon was recorded by a sensor or array: the reverse of detected."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005115 .

icon:0005117 a owl:ObjectProperty ;
    rdfs:label "crosses"@en ;
    IAO:0000115 "The structure carries animals under or over the road or railway, as a wildlife crossing structure crosses the highway it passes beneath."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005007 ;
    owl:inverseOf icon:0005118 .

icon:0005118 a owl:ObjectProperty ;
    rdfs:label "crossed by"@en ;
    IAO:0000115 "The road or railway has a structure that carries animals under or over it: the reverse of crosses."@en ;
    rdfs:domain icon:0005007 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005117 .

icon:0005120 a owl:ObjectProperty ;
    rdfs:label "spills into"@en ;
    IAO:0000115 "Some of this place's water leaves for the other at one point, as a river spills over a weir into a flood bypass, while the place as a whole may lie downstream of the other too: the Sacramento River spills into the Yolo Bypass, which rejoins it lower down. Unlike is upstream of it does not chain, so the river's tributaries are not taken to lie upstream of the bypass."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005121 .

icon:0005121 a owl:ObjectProperty ;
    rdfs:label "receives spill from"@en ;
    IAO:0000115 "The reverse of spills into."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005120 .

icon:0005122 a owl:ObjectProperty ;
    rdfs:label "has GAP status"@en ;
    IAO:0000115 "The GAP status of the place's lands, as the 30x30 Conserved Areas rate them; a place with lands at both levels has both."@en ;
    rdfs:domain icon:0005000 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005008 ;
    owl:inverseOf icon:0005123 .

icon:0005123 a owl:ObjectProperty ;
    rdfs:label "is GAP status of"@en ;
    IAO:0000115 "The reverse of has GAP status."@en ;
    rdfs:domain icon:0005008 ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0005122 .

icon:0005124 a owl:Class ;
    rdfs:label "important plant area"@en ;
    IAO:0000115 "An area that the California Native Plant Society's Important Plant Areas Initiative identifies as among the most important places in the state for rare plants and rare vegetation types, without itself being protected. Example: a Tier 1 area of the Northwestern California ecoregion around the Mendocino pygmy forest, home to 37 California Rare Plant Rank 1B species."@en ;
    rdfs:comment "Added for the statewide draft Important Plant Areas that CNPS published for review in 2026 (#1210)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

BFO:0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf BFO:0000001 .

BFO:0000024 a owl:Class ;
    rdfs:label "fiat object part"@en ;
    rdfs:subClassOf BFO:0000040 .

ENVO:00000029 a owl:Class ;
    rdfs:label "watercourse"@en ;
    IAO:0000115 "A flowing body of water."@en ;
    rdfs:subClassOf ENVO:01000618 .

ENVO:00000074 a owl:Class ;
    rdfs:label "dam"@en ;
    IAO:0000115 "A barrier constructed across a watercourse to control the flow or raise the level of water."@en ;
    rdfs:subClassOf ENVO:01000467 .

ENVO:00000309 a owl:Class ;
    rdfs:label "depressed landform"@en ;
    IAO:0000115 "A landform sunken or depressed below the surrounding area."@en ;
    rdfs:subClassOf ENVO:01001886 .

ENVO:01001784 a owl:Class ;
    rdfs:label "compound astronomical body part"@en ;
    IAO:0000115 "A part of an astronomical body which is composed of a continuous medium bearing liquid, gaseous, and solid material in variable quantities."@en ;
    rdfs:subClassOf ENVO:01000813 .

ENVO:01001884 a owl:Class ;
    rdfs:label "surface landform"@en ;
    IAO:0000115 "A landform which occurs on the surface of an astronomical body."@en ;
    rdfs:subClassOf ENVO:01001886 .

RO:0002577 a owl:Class ;
    rdfs:label "system"@en ;
    IAO:0000115 "A material entity consisting of multiple components that are causally integrated."@en ;
    rdfs:subClassOf BFO:0000040 .

icon:0005005 a owl:Class ;
    rdfs:label "food production infrastructure"@en ;
    IAO:0000115 "Land or facilities used to grow crops or raise animals."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( icon:0005032 icon:0005033 ) ] .

icon:0005032 a owl:Class ;
    rdfs:label "animal production site"@en ;
    IAO:0000115 "A ranch, dairy, feedlot or other place where animals are raised."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005005 ;
    skos:closeMatch ENVO:00000078,
        ENVO:01000627 .

BFO:0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    IAO:0000115 "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])"@en ;
    rdfs:subClassOf BFO:0000002 .

ENVO:00000063 a owl:Class ;
    rdfs:label "water body"@en ;
    IAO:0000115 "An accumulation of water of varying size."@en ;
    rdfs:subClassOf ENVO:01000685 .

ENVO:01000617 a owl:Class ;
    rdfs:label "lentic water body"@en ;
    IAO:0000115 "A lentic water body is a water body in which the accumulated water, in its totality, has very little to no directed flow."@en ;
    rdfs:subClassOf ENVO:00000063 .

ENVO:01001886 a owl:Class ;
    rdfs:label "landform"@en ;
    IAO:0000115 "A solid astronomical body part which has been formed from and is composed primarily of the matter of that astronomical body."@en ;
    rdfs:subClassOf ENVO:00000191 .

OBI:0000245 a owl:Class ;
    rdfs:label "organization"@en ;
    IAO:0000115 "An organization is a continuant entity which can play roles,  has members, and has a set of organization rules.  Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members."@en ;
    rdfs:subClassOf BFO:0000004 .

icon:0000100 a owl:ObjectProperty ;
    rdfs:label "is involved with"@en ;
    IAO:0000115 "A link between two records that work together or affect one another. Every more specific involvement link (leads, funds, manages, uses, is partner of and others) implies it."@en ;
    rdfs:isDefinedBy iconbase:core.owl .

icon:0005008 a owl:Class ;
    rdfs:label "GAP status"@en ;
    IAO:0000115 "How a protected place is managed for biodiversity on the USGS Gap Analysis Project scale, as California's 30x30 Conserved Areas rate it; only GAP 1 and 2 count toward 30x30 (#427)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf IAO:0000030 .

ENVO:01000813 a owl:Class ;
    rdfs:label "astronomical body part"@en ;
    IAO:0000115 "A material part of an astronomical body."@en ;
    rdfs:subClassOf BFO:0000040 .

ENVO:01001567 a owl:Class ;
    rdfs:label "protected area"@en ;
    IAO:0000115 "An environmental zone which 1) contains ecosystems, constructed features, or other entities deemed to be of natural, historical, cultural, or other significance and 2) has been afforded legal protections restricting one or more forms of use by a competent authority."@en ;
    rdfs:subClassOf ENVO:01003020 .

BFO:0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf BFO:0000004 .

ENVO:00002214 a owl:Class ;
    rdfs:label "power plant"@en ;
    IAO:0000115 "A power plant is a building which contains one or more generators which convert mechanical energy into electrical energy through the relative motion between a magnetic field and a conductor. The energy source harnessed to turn the generator varies widely."@en ;
    rdfs:subClassOf ENVO:00003861 .

icon:0005003 a owl:Class ;
    rdfs:label "water infrastructure"@en ;
    IAO:0000115 "A work that stores, moves, controls or recharges water."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ENVO:00000014 ENVO:00000256 icon:0005020 ENVO:00000178 icon:0005022 icon:0005023 ENVO:00000025 icon:0005021 icon:0005024 icon:0005055 ENVO:00000535 ) ] .

icon:0005007 a owl:Class ;
    rdfs:label "transport infrastructure"@en ;
    IAO:0000115 "A route that carries people, vehicles or goods across the landscape: a trail, a highway, a local road, a railway or a bridge."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( icon:0005043 icon:0005044 icon:0005045 icon:0005046 icon:0005057 ) ] .

icon:0005004 a owl:Class ;
    rdfs:label "energy infrastructure"@en ;
    IAO:0000115 "A work that generates or carries electric power."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ENVO:00002214 icon:0005030 icon:0005031 ) ] .

icon:0011000 a owl:Class ;
    rdfs:label "taxon"@en ;
    IAO:0000115 "A species or a group of species that records concern, identified by its NatureServe element where it has one. Groups (salmonids, bats) are taxa at a higher rank or informal groupings of them."@en ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:subClassOf PCO:0000059 .

icon:0005002 a owl:Class ;
    rdfs:label "green infrastructure"@en ;
    IAO:0000115 "Land or water held or designed for wildlife and habitat: conservation areas, mitigation banks, greenbelts, corridors and crossing structures."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( icon:0005034 icon:0005035 icon:0005036 icon:0005037 icon:0005038 icon:0005039 ENVO:01000930 icon:0005040 icon:0005051 icon:0005052 icon:0005124 ) ] .

ENVO:00000070 a owl:Class ;
    rdfs:label "human construction"@en ;
    IAO:0000115 "A construction that has been assembled by deliberate human effort."@en ;
    rdfs:subClassOf ENVO:01000813,
        ENVO:01001813 .

icon:0005000 a owl:Class ;
    rdfs:label "infrastructure"@en ;
    IAO:0000115 "A place or structure on the landscape that conservation works on or around: a water body, a conservation area, a water or energy work, a farm, a sensor, a road or trail. Called infrastructure in the PPOD model whether built or natural."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0000012 ;
    skos:closeMatch gsp:Feature .

iconbase:infrastructure.owl a owl:Ontology ;
    dcterms:creator "Internet of Conservation (ICON)" ;
    dcterms:description "Places and structures on the landscape that conservation works on or around: waters (blue), conservation lands (green), water works, energy, food production and sensors. Covers their types, ownership and management, and how they lie relative to one another (upstream, adjacent, intersecting)."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:references obo:cob.owl,
        obo:envo.owl,
        obo:iao.owl,
        obo:obi.owl,
        obo:ro.owl,
        <http://www.opengis.net/ont/geosparql> ;
    dcterms:title "ICON Infrastructure ontology"@en ;
    rdfs:comment "Existing ontologies used. Reused: Environment Ontology. Built on: Core Ontology for Biology and Biomedicine, Environment Ontology, Information Artifact Ontology, Ontology for Biomedical Investigations, Relation Ontology. Mapped to: Environment Ontology, GeoSPARQL, Relation Ontology."@en ;
    rdfs:seeAlso iconbase:biodiversity.owl,
        iconbase:core.owl ;
    owl:versionIRI <https://w3id.org/icon-ioc/releases/2026-11-21/infrastructure.owl> ;
    owl:versionInfo "2026-11-21" .

