<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iconbase="https://w3id.org/icon-ioc/"
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
    <obo:IAO_0000115 xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">independent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">process</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fiat object part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">material entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
    <obo:IAO_0000115 xml:lang="en">a core relation that holds between a part and its whole</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">part of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
    <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000051">
    <obo:IAO_0000115 xml:lang="en">a core relation that holds between a whole and its part</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">has part</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/COB_0000082">
    <obo:IAO_0000115 xml:lang="en">A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">planned process</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">administrative region</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01003020"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000254">
    <obo:IAO_0000115 xml:lang="en">A system which has the disposition to environ one or more material entities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">environmental system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000276">
    <obo:IAO_0000115 xml:lang="en">A large unit of land or water containing a geographically distinct assemblage of species, natural communities, and environmental conditions.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ecoregion</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001110"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000813">
    <obo:IAO_0000115 xml:lang="en">A material part of an astronomical body.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">astronomical body part</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001110">
    <obo:IAO_0000115 xml:lang="en">An environmental system which includes both living and non-living components.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ecosystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000254"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01003020">
    <obo:IAO_0000115 xml:lang="en">A part of an environmental system whose boundaries are determined by fiat.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fiat part of an astronomical object</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GEO_000000393">
    <obo:IAO_0000115 xml:lang="en">a geopolitical organization that is voluntary and private, whose members are individual persons or organizations that come together to acheive a common purpose.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">nongovernmental organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GEO_000000400">
    <obo:IAO_0000115 xml:lang="en">An organization that governs the people living in a particular geographical region or aggregate of geographical regions.  The geographical region it governs can change over time (such as the westward expansion of the United States and the addition of Hawaii). 

Note: this definition was taken over from "geopolitical organization".</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">governmental organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000083916"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GEO_000083916">
    <obo:IAO_0000115 xml:lang="en">An organization consisting of private entities (people or organizations) who engage in goal-oriented decision-making; creating rules, norms, or laws; and encouraging or incentivizing adherence to them that are directed at a population of people, and whose actions are not enforced by state entities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">governance organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>definition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245">
    <obo:IAO_0000115 xml:lang="en">An organization is a continuant entity which can play roles,  has members, and has a set of organization rules.  Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000846">
    <obo:IAO_0000115 xml:lang="en">Relating a legal person or organization to an organization in the case where the legal person or organization has a role as member of the organization.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is member of organization</rdfs:label>
    <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001688"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001688">
    <obo:IAO_0000115 xml:lang="en">Relating an organization to a legal person or organization.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has organization member</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0001025">
    <obo:IAO_0000115 xml:lang="en">a relation between two independent continuants, the target and the location, in which the target is entirely within the location</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">located in</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002131">
    <obo:IAO_0000115 xml:lang="en">x overlaps y if and only if there exists some z such that x has part z and z part of y</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">overlaps</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002323"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002215">
    <obo:IAO_0000115 xml:lang="en">A relation between a material entity (such as a cell) and a process, in which the material entity has the ability to carry out the process. </obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">capable of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002216"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002216">
    <obo:IAO_0000115 xml:lang="en">c stands in this relationship to p if and only if there exists some p' such that c is capable_of p', and p' is part_of p.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">capable of part of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002500"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002323">
    <obo:IAO_0000115 xml:lang="en">A mereological relationship or a topological relationship</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">mereotopologically related to</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002328">
    <obo:IAO_0000115 xml:lang="en">A grouping relationship for any relationship directly involving a function, or that holds because of a function of one of the related entities.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">functionally related to</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002410">
    <obo:IAO_0000115 xml:lang="en">relation that links two events, processes, states, or objects such that one event, process, state, or object (a cause) contributes to the production of another event, process, state, or object (an effect) where the cause is partly or wholly responsible for the effect, and the effect is partly or wholly dependent on the cause.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">causally related to</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002500">
    <obo:IAO_0000115 xml:lang="en">A relationship between a material entity and a process where the material entity has some causal role that influences the process</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">causal agent in process</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002595"/>
    <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002608"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002577">
    <obo:IAO_0000115 xml:lang="en">A material entity consisting of multiple components that are causally integrated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002595">
    <obo:IAO_0000115 xml:lang="en">A relationship that holds between a material entity and a process in which causality is involved, with either the material entity or some part of the material entity exerting some influence over the process, or the process influencing some aspect of the material entity.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">causal relation between material entity and a process</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002608">
    <obo:IAO_0000115 xml:lang="en">Inverse of 'causal agent in process'</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">process has causal agent</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>database_cross_reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>has_exact_synonym</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#narrowMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0000001">
    <obo:IAO_0000115 xml:lang="en">The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as "EML 2.2: dataset/title".</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:label xml:lang="en">crosswalk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0000100">
    <obo:IAO_0000115 xml:lang="en">A link between two records that work together or affect one another. Every more specific involvement link (leads, funds, manages, uses, is partner of and others) implies it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:label xml:lang="en">is involved with</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001001">
    <obo:IAO_0000115 xml:lang="en">A university, college or research institute, or a department of one.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">academic organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <skos:closeMatch rdf:resource="https://schema.org/CollegeOrUniversity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001002">
    <obo:IAO_0000115 xml:lang="en">A business run for profit, such as a consultancy, a utility company, a farm business or a developer.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">commercial organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <skos:closeMatch rdf:resource="https://schema.org/Corporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001003">
    <obo:IAO_0000115 xml:lang="en">An agency or office of the United States government, such as the Fish and Wildlife Service or the Bureau of Reclamation.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">federal government organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000000400"/>
    <skos:closeMatch rdf:resource="https://schema.org/GovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001004">
    <obo:IAO_0000115 xml:lang="en">An agency, department, board or commission of the State of California, such as the Department of Fish and Wildlife.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">state government organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000000400"/>
    <skos:closeMatch rdf:resource="https://schema.org/GovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001005">
    <obo:IAO_0000115 xml:lang="en">A county, city, special district (water, resource conservation, flood control) or one of their departments.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">local government organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000000400"/>
    <skos:closeMatch rdf:resource="https://schema.org/GovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001006">
    <obo:IAO_0000115 xml:lang="en">A public agency formed by two or more public agencies under California's Joint Exercise of Powers Act to carry out a shared purpose, such as a regional water or habitat authority.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">joint powers authority</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000000400"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001007">
    <obo:IAO_0000115 xml:lang="en">A tribal government or an organization of one or more tribes or tribal members.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">tribal organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001008">
    <obo:IAO_0000115 xml:lang="en">A private organization that does not distribute profit, such as a land trust, a watershed group or a conservation society.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">non-profit organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000000393"/>
    <skos:closeMatch rdf:resource="https://schema.org/NGO"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001009">
    <obo:IAO_0000115 xml:lang="en">A private organization, usually endowed, that makes grants to others' work.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">foundation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0001942"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001010">
    <obo:IAO_0000115 xml:lang="en">A standing collaboration of several organizations with a name of its own, such as a regional conservation partnership or a working group.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">partnership</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#OrganizationalCollaboration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001011">
    <obo:IAO_0000115 xml:lang="en">A unit inside an organization with a name of its own, such as a program office or a field crew.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">team</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001012">
    <obo:IAO_0000115 xml:lang="en">An organization whose members are national governments, set up by a treaty or convention, such as a regional fisheries management commission.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">international organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001013">
    <obo:IAO_0000115 xml:lang="en">An incorporated city or town of California, or one of its departments, boards or commissions.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">city government organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001014">
    <obo:IAO_0000115 xml:lang="en">A county of California, or one of its departments, boards or commissions, such as a county parks department or fish and game commission.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">county government organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001015">
    <obo:IAO_0000115 xml:lang="en">A local agency formed under state law to provide one or a few services within set boundaries, such as a water, irrigation, resource conservation, park, flood control or sanitation district.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">special district</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001016">
    <obo:IAO_0000115 xml:lang="en">A local agency that serves several cities or counties together, such as a council of governments or a regional transportation commission.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">regional agency</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001020">
    <obo:IAO_0000115 xml:lang="en">A kind of work an organization carries out, from the Terms sheet's organization activities. An organization is linked to the kinds it is capable of.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">organizational activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001021">
    <obo:IAO_0000115 xml:lang="en">Buying land, water or easements, or rights in them, for conservation.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">acquisition activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001022">
    <obo:IAO_0000115 xml:lang="en">Giving expert advice to landowners, agencies or other organizations.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">advising activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001023">
    <obo:IAO_0000115 xml:lang="en">Arguing for a cause or a policy before the public or decision makers.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">advocacy activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001024">
    <obo:IAO_0000115 xml:lang="en">Growing crops or raising livestock.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">agricultural production activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001025">
    <obo:IAO_0000115 xml:lang="en">Checking that land, products or practices meet a standard and certifying them.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">certification activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001026">
    <obo:IAO_0000115 xml:lang="en">Building or rebuilding structures, such as fish passage, levees or crossings.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">construction activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001027">
    <obo:IAO_0000115 xml:lang="en">Bringing organizations together and keeping their work aligned.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">coordinating activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001028">
    <obo:IAO_0000115 xml:lang="en">Teaching the public, students or practitioners.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">education activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001029">
    <obo:IAO_0000115 xml:lang="en">Paying for other organizations' work, as through grants or contracts.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">funding activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001030">
    <obo:IAO_0000115 xml:lang="en">Exercising public authority over a jurisdiction.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">governing activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001031">
    <obo:IAO_0000115 xml:lang="en">Restoring or improving habitat, such as replanting, removing invasive plants or reconnecting floodplains.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym xml:lang="en">habitat restoration</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym xml:lang="en">restoration</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">habitat enhancement activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001032">
    <obo:IAO_0000115 xml:lang="en">Managing land, water or wildlife over time.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">management activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001033">
    <obo:IAO_0000115 xml:lang="en">Preparing plans for conservation, land use or resources.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">planning activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001034">
    <obo:IAO_0000115 xml:lang="en">Making or shaping policy.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">policy activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001035">
    <obo:IAO_0000115 xml:lang="en">Producing goods or energy other than crops and livestock.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">production activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001036">
    <obo:IAO_0000115 xml:lang="en">Issuing and enforcing permits and rules.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">regulating activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001037">
    <obo:IAO_0000115 xml:lang="en">Studying nature or conservation.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">research activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0000066"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001038">
    <obo:IAO_0000115 xml:lang="en">Providing services to others, such as technical, legal or financial services.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">services activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001039">
    <obo:IAO_0000115 xml:lang="en">Repeating surveys or measurements over years to track the status of species, habitats, water or fisheries.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">monitoring activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001100">
    <obo:IAO_0000115 xml:lang="en">Links an organization to one of the organization type classes it belongs to. The explorer's way of stating the organization's class.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">has org type</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001101"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001101">
    <obo:IAO_0000115 xml:lang="en">The reverse of has org type.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is org type of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001100"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001102">
    <obo:IAO_0000115 xml:lang="en">A kind of activity an organization carries out: the reverse of capable of.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is activity of</rdfs:label>
    <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001103">
    <obo:IAO_0000115 xml:lang="en">An organization belongs to a coalition, association or partnership as a member while keeping its own identity. A kind of part of in the explorer.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is member of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000846"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001104"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#memberOf"/>
    <skos:closeMatch rdf:resource="https://schema.org/memberOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001104">
    <obo:IAO_0000115 xml:lang="en">The reverse of is member of.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">has member</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001688"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001103"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#hasMember"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001105">
    <obo:IAO_0000115 xml:lang="en">An organization that works on a project or program alongside its lead, without leading or funding it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">has partner</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon-ioc/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001106"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001106">
    <obo:IAO_0000115 xml:lang="en">The reverse of has partner.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is partner of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon-ioc/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001105"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001107">
    <obo:IAO_0000115 xml:lang="en">The organization responsible for making data or a publication available, when it is not the creator.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is published by</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001108"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/publisher"/>
    <skos:closeMatch rdf:resource="https://schema.org/publisher"/>
    <iconbase:ICON_0000001>DataCite 4.5: publisher</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: dataset/publisher</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: CI_RoleCode publisher</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001108">
    <obo:IAO_0000115 xml:lang="en">The reverse of is published by.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">published</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001109">
    <obo:IAO_0000115 xml:lang="en">The county that holds the organization's headquarters, main office or seat. An organization is located in at most one county, and may operate in many (#949).</obo:IAO_0000115>
    <oboInOwl:hasDbXref>Wikidata:P159</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Every local government is located in one county. A city's is the county the city lies in, a county government's is its own county, and a special district's or regional agency's is the county of its main office. Located in county is a kind of located in area, so the organization also operates in the county.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">located in county</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon-ioc/ICON_0010000"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon-ioc/ICON_0010104"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001110"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#hasPrimarySite"/>
    <skos:closeMatch rdf:resource="https://schema.org/location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001110">
    <obo:IAO_0000115 xml:lang="en">The reverse of located in county: the county holds the organization's headquarters.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon-ioc/ICON_0010000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is county location of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001109"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001111">
    <obo:IAO_0000115 xml:lang="en">The ecoregion section that holds the organization's headquarters, main office or seat. An organization is located in at most one ecoregion section, and may work in many (#949).</obo:IAO_0000115>
    <oboInOwl:hasDbXref>Wikidata:P159</oboInOwl:hasDbXref>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Every local government is located in one ecoregion section, the one its headquarters point lies in. Located in ecoregion is a kind of in ecoregion, so a question about the local governments in an ecoregion finds it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">located in ecoregion</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000276"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon-ioc/ICON_0010108"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001112"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#hasPrimarySite"/>
    <skos:closeMatch rdf:resource="https://schema.org/location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001112">
    <obo:IAO_0000115 xml:lang="en">The reverse of located in ecoregion: the ecoregion section holds the organization's headquarters.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000276"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">is ecoregion location of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0001111"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0010000">
    <obo:IAO_0000115 xml:lang="en">One of California's 58 counties, as an administrative region rather than as its government.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/places.owl"/>
    <rdfs:label xml:lang="en">county</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0010100">
    <obo:IAO_0000115 xml:lang="en">The record works in, covers or is about the area. A county cell of All in a workbook links the record to statewide instead.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/places.owl"/>
    <rdfs:label xml:lang="en">operates in</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0010104">
    <obo:IAO_0000115 xml:lang="en">A place, objective or action lies in the area. A kind of operates in, and a kind of the Relation Ontology's located in.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/places.owl"/>
    <rdfs:label xml:lang="en">located in area</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon-ioc/ICON_0010100"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0010108">
    <obo:IAO_0000115 xml:lang="en">The record works in, covers or lies in the ecoregion section.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/places.owl"/>
    <rdfs:label xml:lang="en">in ecoregion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/organizations.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">Organizations in conservation: agencies, non-profits, tribes, companies, universities and partnerships, their types and activities, how they nest and join one another, and the links by which they publish, host, fund or partner in other work.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/cob.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/geo.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
    <dcterms:references rdf:resource="http://purl.org/dc/terms/"/>
    <dcterms:references rdf:resource="http://www.w3.org/ns/org"/>
    <dcterms:references rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <dcterms:references rdf:resource="https://schema.org/"/>
    <dcterms:title xml:lang="en">ICON Organizations ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Reused: Ontology for Biomedical Investigations, Relation Ontology. Built on: Basic Formal Ontology, Core Ontology for Biology and Biomedicine, Environment Ontology, Geographical Entity Ontology, Ontology for Biomedical Investigations, Relation Ontology. Mapped to: Dublin Core terms, FOAF, Ontology for Biomedical Investigations, W3C Organization Ontology, schema.org.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/places.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon-ioc/releases/2026-11-21/organizations.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
