    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014001"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">baseline value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0014203">
    <obo:IAO_0000115 xml:lang="en">The year of the baseline value.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014001"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">baseline year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0014204">
    <obo:IAO_0000115 xml:lang="en">The year by which the target is to be met.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014001"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">target year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0014205">
    <obo:IAO_0000115 xml:lang="en">The outcome's amount in its indicator's unit.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">outcome value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0014206">
    <obo:IAO_0000115 xml:lang="en">The year the outcome was measured, or is expected to be delivered.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">outcome year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0014207">
    <obo:IAO_0000115 xml:lang="en">Expected (an expected outcome, as a grant award or proposal states it) or measured (a measured outcome, as a report or inventory records it).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014002"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">outcome status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0014208">
    <obo:IAO_0000115 xml:lang="en">The whole a target's percentages are of, in its indicator's unit, such as California's land area for a goal of conserving 30 percent of its lands. A target with a total is shown in both amounts and percentages.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0014001"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/outcomes.owl"/>
    <rdfs:label xml:lang="en">target total</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/outcomes.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">What conservation work is measured by: indicators with their units, the targets that objectives, plans, programs and guidelines or mandates set on them, and the outcomes projects and places deliver, linked by the results chain (contributes to) so progress toward a target can be added up.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:title xml:lang="en">ICON Indicators, targets and outcomes ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Built on: Information Artifact Ontology. Mapped to: Ontology for Biomedical Investigations.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/mandates.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/plans.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/programs.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/projects.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon/releases/2026-11-21/outcomes.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
