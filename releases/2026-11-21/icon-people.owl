    <rdfs:label xml:lang="en">Metazoa</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33154"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_33213">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bilateria</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33208"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_40674">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mammalia</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_32524"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_7742">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vertebrata &lt;vertebrates&gt;</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33213"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Homo sapiens</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_314146"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245">
    <obo:IAO_0000115 xml:lang="en">An organization is a continuant entity which can play roles,  has members, and has a set of organization rules.  Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OMRSE_00002072">
    <obo:IAO_0000115 xml:lang="en">A role that inheres in some entity that is realized in a social act.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">role in human social processes</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000000">
    <obo:IAO_0000115 xml:lang="en">A material entity that consists of two or more organisms, viruses, or viroids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collection of organisms</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000031">
    <obo:IAO_0000115 xml:lang="en">A material entity that is one or more organisms, viruses or viroids.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organismal entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PCO_0000059">
    <obo:IAO_0000115 xml:lang="en">A collection of organisms that has as members every organism of a taxon and no organisms of any other equal or higher ranked taxon. The taxon may be at any level. If the taxon is species, then this is the same as the class species as a collection of organisms. When defining a taxon, it is generally understood that members include both living organisms and dead organisms that are known through specimens or observations.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">taxon as collection of organisms</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002577">
    <obo:IAO_0000115 xml:lang="en">A material entity consisting of multiple components that are causally integrated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>database_cross_reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>has_exact_synonym</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#narrowMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000001">
    <obo:IAO_0000115 xml:lang="en">The matching field in a metadata standard that is not published as RDF, written as the standard's name, a colon and the field's path, such as "EML 2.2: dataset/title".</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">crosswalk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0000100">
    <obo:IAO_0000115 xml:lang="en">A link between two records that work together or affect one another. Every more specific involvement link (leads, funds, manages, uses, is partner of and others) implies it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:label xml:lang="en">is involved with</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002001">
    <obo:IAO_0000115 xml:lang="en">A role in human social processes that a person holds when an organization, project or program puts them in charge of some part of it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">leadership role</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00002072"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#Role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002002">
    <obo:IAO_0000115 xml:lang="en">Heads the record's staff or operations: executive director, CEO, staff president, general manager, agency director or secretary, city manager, and the manager of a field office, region, refuge or preserve that is itself the record.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">chief executive role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002003">
    <obo:IAO_0000115 xml:lang="en">Second in the staff line: deputy, associate or assistant director, chief operating officer, undersecretary or deputy secretary, assistant or associate field manager.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">deputy executive role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002004">
    <obo:IAO_0000115 xml:lang="en">Chairs the governing board, council or commission: chair, chairman, board president, tribal chair.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">board chair role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002005">
    <obo:IAO_0000115 xml:lang="en">An officer of the governing board other than its chair: vice chair, vice president of the board, secretary, treasurer.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">board officer role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002006">
    <obo:IAO_0000115 xml:lang="en">Leads a program, division or department within the record: program director, manager or coordinator, branch chief, program area chair.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">program leader role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002007">
    <obo:IAO_0000115 xml:lang="en">Leads a particular project: project manager, project coordinator, project lead.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">project leader role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002008">
    <obo:IAO_0000115 xml:lang="en">Leads the record's science: principal investigator, lead or chief scientist, science director.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">science leader role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0002001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002009">
    <obo:IAO_0000115 xml:lang="en">Holds an office the voters of a district or the state elect to: Assemblymember, State Senator, U.S. Representative, U.S. Senator, county supervisor.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">elected official role</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00002072"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002100">
    <obo:IAO_0000115 xml:lang="en">A person works for, serves on the board of, or is otherwise attached to an organization. The link may carry the person's title and its role type.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">is affiliated with</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002101"/>
    <skos:closeMatch rdf:resource="https://schema.org/affiliation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002101">
    <obo:IAO_0000115 xml:lang="en">The reverse of is affiliated with.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">has affiliate</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002100"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002102">
    <obo:IAO_0000115 xml:lang="en">The person to ask about an organization, project, place or data resource. The person's contact details are private.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">has contact</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002103"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#contactPoint"/>
    <iconbase:ICON_0000001>DataCite 4.5: contributorType ContactPerson</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: dataset/contact</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: CI_RoleCode pointOfContact</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002103">
    <obo:IAO_0000115 xml:lang="en">The reverse of has contact.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">is contact for</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002102"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002104">
    <obo:IAO_0000115 xml:lang="en">A person knows an issue, a place, a taxon or a habitat type through their work: the projects, programs and plans they lead and the papers and reports they wrote address it, or the source records say so. Expertise is never passed down from the organizations a person belongs to.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The explorer entails it from the issues, counties, ecoregions, taxa and habitat types a person's led or authored record states itself. A statewide record gives no place expertise, and a record that names more than 10 of one kind gives none of that kind (#1130). Expertise in a component issue is expertise in its integrated issues too, and expertise in a vegetation or CMECS type is expertise in its broader types (#1409, #1410).</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">has expertise in</rdfs:label>
    <rdfs:range rdf:nodeID="cb134c35fbd31229080c7224acecfc10863f2ff5ff8f78110ce7ab710b861937ab7"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002105"/>
    <owl:propertyChainAxiom rdf:nodeID="cb27a6cf2be636e8f75f40f545ad89ab8643874549d5bab357dde64a7acde78de9a"/>
    <owl:propertyChainAxiom rdf:nodeID="cb27e89810f5649b67c5f2c03d21f222fc09bb71aba619cec5d242a7bc6d10d7917"/>
    <skos:closeMatch rdf:resource="https://schema.org/knowsAbout"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002105">
    <obo:IAO_0000115 xml:lang="en">The reverse of has expertise in.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cbd0ca1bee0f116308feff8e655e66a134d292d61f7d127b4b9c8f692b3af9478d"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">is expertise of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002104"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002106">
    <obo:IAO_0000115 xml:lang="en">An elected official holds the seat of the district: a member of the State Assembly or State Senate, a member of Congress, or a county supervisor. A U.S. senator represents the whole state (#1432).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The office and party are the link's role title, and the year the person took the seat is the link's start.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">represents</rdfs:label>
    <rdfs:range rdf:nodeID="cbf690a879c411db0118a33df6aa8dc69fd7cbcda8d28fe6394279b9f833c33fe0"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002107">
    <obo:IAO_0000115 xml:lang="en">The reverse of represents.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cb19a228bb1fe478871a787eed4955e3bb967357f67941b9ace4ad5d01a51ead5af"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">is represented by</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002106"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002200">
    <obo:IAO_0000115 xml:lang="en">A person's title in the role a link records, as the organization or project writes it: Executive Director, Principal Investigator.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">role title</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002201">
    <obo:IAO_0000115 xml:lang="en">The uniform kind of a role a link records, one of the leadership roles below, so titles that differ in wording can be compared.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">role type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002300">
    <obo:IAO_0000115 xml:lang="en">The address of the person's public LinkedIn profile: https://www.linkedin.com/in/name.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">LinkedIn profile</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/account"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002301">
    <obo:IAO_0000115 xml:lang="en">The person's ORCID identifier, the persistent researcher id used by journals and funders: 0000-0002-1825-0097.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">ORCID iD</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:closeMatch rdf:resource="https://schema.org/identifier"/>
    <iconbase:ICON_0000001>DataCite 4.5: creator/nameIdentifier (nameIdentifierScheme ORCID)</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0010000">
    <obo:IAO_0000115 xml:lang="en">One of California's 58 counties, as an administrative region rather than as its government.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/places.owl"/>
    <rdfs:label xml:lang="en">county</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0010003">
    <obo:IAO_0000115 xml:lang="en">An extent a record can claim in place of a list of areas.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/places.owl"/>
    <rdfs:label xml:lang="en">geographic scope</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0010005">
    <obo:IAO_0000115 xml:lang="en">An area whose voters elect an official to a legislature or a county board: a California State Assembly, State Senate, congressional or county supervisorial district (#1432).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/places.owl"/>
    <rdfs:label xml:lang="en">electoral district</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011000">
    <obo:IAO_0000115 xml:lang="en">A species or a group of species that records concern, identified by its NatureServe element where it has one. Groups (salmonids, bats) are taxa at a higher rank or informal groupings of them.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">taxon</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011001">
    <obo:IAO_0000115 xml:lang="en">A habitat type of the California Wildlife Habitat Relationships system, the state's standard classification of wildlife habitats (59 types, such as Valley Foothill Riparian or Blue Oak Woodland), identified by its CWHR code.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">CWHR habitat type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011004">
    <obo:IAO_0000115 xml:lang="en">A unit of vegetation: an alliance of the Manual of California Vegetation, as CDFW's California Natural Communities List names it (such as Valley oak woodland and forest, or Fremont's goldfields - Downingia vernal pools), or a group, macrogroup or division of the US National Vegetation Classification above it (#1409).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">vegetation type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011005">
    <obo:IAO_0000115 xml:lang="en">A unit of the Coastal and Marine Ecological Classification Standard (CMECS, FGDC-STD-018-2012): a system, subsystem or tidal zone of its Aquatic Setting (such as Estuarine Coastal Intertidal Tidal Zone), or a biotic setting, class, subclass or group of its Biotic Component (such as Seagrass Bed), identified by its CMECS ID (#1410).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">coastal and marine habitat type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011108">
    <obo:IAO_0000115 xml:lang="en">Links a habitat or vegetation type to a broader one that contains it: an MCV alliance to its USNVC group, a group to its macrogroup, a CMECS unit to the unit above it, a GET functional group to its biome and a biome to its realm, and an alliance or CMECS unit to the one CWHR habitat type it falls in. A record that has the narrower type has the broader one too (#1409, #1410, #1411).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has broader habitat type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0012000">
    <obo:IAO_0000115 xml:lang="en">A problem, pressure or concern conservation work responds to, such as water quality, wildfire, habitat loss or a declining species. Issues are of many kinds (processes, qualities, entities), so the class sits directly under entity.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/issues.owl"/>
    <rdfs:label xml:lang="en">conservation issue</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0012102">
    <obo:IAO_0000115 xml:lang="en">Links a component issue to an integrated issue it is primarily part of, as the issue list of Springer et al. (2022) records: Floods has broader issues Water and Disasters. A record that addresses the component issue addresses the integrated one too.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/issues.owl"/>
    <rdfs:label xml:lang="en">has broader issue</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/people.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">People named in the graph: whom they are affiliated with, whom they are the contact for, and the leadership roles they hold. Names are public; contact details are kept out of the graph's public face and out of this ontology.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/ncbitaxon.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
    <dcterms:references rdf:resource="http://www.w3.org/ns/dcat"/>
    <dcterms:references rdf:resource="http://www.w3.org/ns/org"/>
    <dcterms:references rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <dcterms:references rdf:resource="https://schema.org/"/>
    <dcterms:title xml:lang="en">ICON People ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Reused: NCBI organismal classification. Built on: Environment Ontology, Ontology for Biomedical Investigations, Ontology of Medically Related Social Entities. Mapped to: DCAT 3 (W3C Data Catalog Vocabulary), FOAF, W3C Organization Ontology, schema.org.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/issues.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/places.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon/releases/2026-11-21/people.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
