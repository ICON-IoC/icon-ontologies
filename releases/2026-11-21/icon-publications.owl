  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009104">
    <obo:IAO_0000115 xml:lang="en">The organization a technical report was prepared for, when someone else wrote it, as a consultant's report for an agency.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0009000"/>
