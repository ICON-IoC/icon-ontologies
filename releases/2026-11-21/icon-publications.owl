    <rdfs:label xml:lang="en">publication on request</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009015">
    <obo:IAO_0000115 xml:lang="en">Internal or restricted.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0009010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">publication not public</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009100">
    <obo:IAO_0000115 xml:lang="en">Links a paper or report to the class it belongs to: peer-reviewed paper or technical report. The explorer's way of stating its class.</obo:IAO_0000115>
