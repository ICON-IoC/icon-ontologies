  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009200">
    <obo:IAO_0000115 xml:lang="en">The author list as printed on the work: Smith, J., Lee, K. and Ortiz, M. Public bibliographic information, not contact details.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0009000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">authors</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:closeMatch rdf:resource="http://purl.org/ontology/bibo/authorList"/>
