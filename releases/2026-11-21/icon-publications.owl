    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:closeMatch rdf:resource="https://schema.org/isPartOf"/>
    <iconbase:ICON_0000001>Crossref: journal_metadata/full_title</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009202">
    <obo:IAO_0000115 xml:lang="en">A report's number in its series, such as 2019-1123.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0009002"/>
