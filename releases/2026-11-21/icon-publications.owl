  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009106">
    <obo:IAO_0000115 xml:lang="en">The work is about this project, program, organization or data resource: it reports, evaluates or documents it. A data paper describes its dataset.</obo:IAO_0000115>
