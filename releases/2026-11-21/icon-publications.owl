  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009110">
    <obo:IAO_0000115 xml:lang="en">The work cites another paper or report in the graph.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0009000"/>
