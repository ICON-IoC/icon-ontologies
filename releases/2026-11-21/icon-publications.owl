  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009108">
    <obo:IAO_0000115 xml:lang="en">The work's analysis, or the tool, draws on this dataset, database or repository. For a tool, the workbook's inDataset column.</obo:IAO_0000115>
