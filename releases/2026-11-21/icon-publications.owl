  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009112">
    <obo:IAO_0000115 xml:lang="en">A place where the work's field study or monitoring was done, such as a reserve, a creek or a dam.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon/ICON_0009000"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">studied at</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0005000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0009113"/>
    <skos:closeMatch rdf:resource="https://schema.org/spatialCoverage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009113">
