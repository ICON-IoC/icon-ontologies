  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009001">
    <obo:IAO_0000115 xml:lang="en">An article that independent experts reviewed before a journal or conference published it. A work counts as one only if its journal certainly peer-reviewed it.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">peer-reviewed paper</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000013"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0009000"/>
    <skos:closeMatch rdf:resource="http://purl.org/ontology/bibo/AcademicArticle"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/JournalArticle"/>
    <skos:closeMatch rdf:resource="https://schema.org/ScholarlyArticle"/>
    <iconbase:ICON_0000001>Crossref: journal-article</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>DataCite 4.5: resourceTypeGeneral JournalArticle</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009002">
    <obo:IAO_0000115 xml:lang="en">A report an agency, organization or research group issues itself on a study, a monitoring program, an assessment or a project's results, usually in a numbered series. It may or may not have been reviewed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">technical report</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000088"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0009000"/>
    <skos:closeMatch rdf:resource="http://purl.org/ontology/bibo/Report"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/TechnicalReport"/>
    <skos:closeMatch rdf:resource="https://schema.org/Report"/>
    <iconbase:ICON_0000001>Crossref: report</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>DataCite 4.5: resourceTypeGeneral Report</iconbase:ICON_0000001>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009010">
    <obo:IAO_0000115 xml:lang="en">Who can read a paper or report. Values follow the open-access status Unpaywall and Crossref report.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">publication availability</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009011">
    <obo:IAO_0000115 xml:lang="en">Anyone can read it free from the publisher or a repository.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0009010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">open access publication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009012">
    <obo:IAO_0000115 xml:lang="en">Free to read on the publisher's site but without an open license.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0009010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">free to read publication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009013">
    <obo:IAO_0000115 xml:lang="en">Behind a journal paywall.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icon/ICON_0009010"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/publications.owl"/>
    <rdfs:label xml:lang="en">subscription or purchase publication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0009014">
    <obo:IAO_0000115 xml:lang="en">The authors or issuing agency send it when asked.</obo:IAO_0000115>
