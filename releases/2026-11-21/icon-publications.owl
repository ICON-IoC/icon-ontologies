  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0013000">
    <obo:IAO_0000115 xml:lang="en">Software people use to plan, assess or track conservation work: a decision-support tool, a map viewer, a dashboard, a calculator or model, a software package or an identification key. A site whose main job is holding and serving data is a data repository, not a tool; a tool that works with such data links to it. Read from the master PPOD workbook's Tools sheet.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/tools.owl"/>
    <rdfs:label xml:lang="en">tool</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000010"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0000013"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icon/publications.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">Peer-reviewed papers and technical reports: authors, publishers and sponsors, what a work describes, which data it uses, which works it cites, and where its study was done.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
    <dcterms:references rdf:resource="http://purl.org/dc/terms/"/>
    <dcterms:references rdf:resource="http://purl.org/ontology/bibo/"/>
    <dcterms:references rdf:resource="http://purl.org/spar/cito"/>
    <dcterms:references rdf:resource="http://purl.org/spar/fabio"/>
    <dcterms:references rdf:resource="https://schema.org/"/>
    <dcterms:title xml:lang="en">ICON Papers and reports ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Reused: Bibliographic Ontology (BIBO), Dublin Core terms, schema.org. Built on: Dublin Core terms, Information Artifact Ontology, Ontology for Biomedical Investigations. Mapped to: Bibliographic Ontology (BIBO), Citation Typing Ontology (CiTO), Dublin Core terms, FRBR-aligned Bibliographic Ontology (FaBiO), schema.org.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/core.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/data.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/infrastructure.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon/tools.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon/releases/2026-11-21/publications.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
