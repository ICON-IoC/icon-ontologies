  <rdf:Description rdf:about="https://w3id.org/icon-ioc/tools.owl">
    <dcterms:creator>Internet of Conservation (ICON)</dcterms:creator>
    <dcterms:description xml:lang="en">Software people use to plan, assess and track conservation work: decision-support tools, map viewers, dashboards, calculators and models, and software packages. Covers who builds and uses them, the issues they address, and the data they take in and produce.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:references rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
    <dcterms:references rdf:resource="http://purl.org/dc/terms/"/>
    <dcterms:references rdf:resource="http://www.w3.org/ns/prov-o"/>
    <dcterms:references rdf:resource="https://schema.org/"/>
    <dcterms:title xml:lang="en">ICON Tools ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">Existing ontologies used. Built on: Dublin Core terms, Information Artifact Ontology. Mapped to: PROV-O (W3C provenance), schema.org.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/core.owl"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <owl:versionIRI rdf:resource="https://w3id.org/icon-ioc/releases/2026-11-21/tools.owl"/>
    <owl:versionInfo>2026-11-21</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
