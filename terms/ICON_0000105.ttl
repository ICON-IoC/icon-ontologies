@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0000105 a owl:ObjectProperty ;
    rdfs:label "funded by"@en ;
    IAO:0000115 "An organization or funding source that paid for the work, the data or the publication."@en ;
    rdfs:isDefinedBy iconbase:core.owl ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0000106 ;
    skos:closeMatch frapo:isFundedBy,
        schema:funder ;
    icon:0000001 "DataCite 4.5: fundingReference/funderName",
        "EML 2.2: project/award/funderName",
        "ISO 19115-1: CI_RoleCode funder" .

