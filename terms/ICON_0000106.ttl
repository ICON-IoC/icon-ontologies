@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0000106 a owl:ObjectProperty ;
    rdfs:label "funds"@en ;
    IAO:0000115 "The organization or funding source pays for this work, data or publication: the reverse of funded by and of funded through."@en ;
    rdfs:isDefinedBy iconbase:core.owl ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0000105 ;
    skos:closeMatch frapo:funds .

