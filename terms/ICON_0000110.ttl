@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0000110 a owl:ObjectProperty ;
    rdfs:label "informs"@en ;
    IAO:0000115 "The data or publication is drawn on by a plan, an objective, an action or a guideline or mandate, as survey counts inform a recovery objective."@en ;
    rdfs:isDefinedBy iconbase:core.owl ;
    owl:inverseOf icon:0000111 ;
    skos:broadMatch dcterms:relation .

