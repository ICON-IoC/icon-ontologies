@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0000111 a owl:ObjectProperty ;
    rdfs:label "is informed by"@en ;
    IAO:0000115 "The plan, objective, action or mandate draws on this data or publication: the reverse of informs."@en ;
    rdfs:isDefinedBy iconbase:core.owl ;
    owl:inverseOf icon:0000110 .

