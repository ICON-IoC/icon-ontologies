@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0001001 a owl:Class ;
    rdfs:label "academic organization"@en ;
    IAO:0000115 "A university, college or research institute, or a department of one."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf OBI:0000245 ;
    skos:closeMatch schema:CollegeOrUniversity .

