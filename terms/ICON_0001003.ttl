@prefix GEO: <http://purl.obolibrary.org/obo/GEO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0001003 a owl:Class ;
    rdfs:label "federal government organization"@en ;
    IAO:0000115 "An agency or office of the United States government, such as the Fish and Wildlife Service or the Bureau of Reclamation."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf GEO:000000400 ;
    skos:closeMatch schema:GovernmentOrganization .

