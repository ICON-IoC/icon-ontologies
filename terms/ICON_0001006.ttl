@prefix GEO: <http://purl.obolibrary.org/obo/GEO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0001006 a owl:Class ;
    rdfs:label "joint powers authority"@en ;
    IAO:0000115 "A public agency formed by two or more public agencies under California's Joint Exercise of Powers Act to carry out a shared purpose, such as a regional water or habitat authority."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf GEO:000000400 .

