  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001008">
    <obo:IAO_0000115 xml:lang="en">A private organization that does not distribute profit, such as a land trust, a watershed group or a conservation society.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">non-profit organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GEO_000000393"/>
    <skos:closeMatch rdf:resource="https://schema.org/NGO"/>
  </rdf:Description>
