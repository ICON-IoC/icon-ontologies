<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001011">
    <obo:IAO_0000115 xml:lang="en">A unit inside an organization with a name of its own, such as a program office or a field crew.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/organizations.owl"/>
    <rdfs:label xml:lang="en">team</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
  </rdf:Description>
</rdf:RDF>
