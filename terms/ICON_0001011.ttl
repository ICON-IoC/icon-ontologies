@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0001011 a owl:Class ;
    rdfs:label "team"@en ;
    IAO:0000115 "A unit inside an organization with a name of its own, such as a program office or a field crew."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf OBI:0000245 ;
    skos:closeMatch org:OrganizationalUnit .

