  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0001012">
    <obo:IAO_0000115 xml:lang="en">An organization whose members are national governments, set up by a treaty or convention, such as a regional fisheries management commission.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/organizations.owl"/>
    <rdfs:label xml:lang="en">international organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
  </rdf:Description>
</rdf:RDF>
