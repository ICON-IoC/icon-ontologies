  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0001016">
    <obo:IAO_0000115 xml:lang="en">A local agency that serves several cities or counties together, such as a council of governments or a regional transportation commission.</obo:IAO_0000115>
