@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0001016 a owl:Class ;
    rdfs:label "regional agency"@en ;
    IAO:0000115 "A local agency that serves several cities or counties together, such as a council of governments or a regional transportation commission."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf icon:0001005 .

