@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0001024 a owl:Class ;
    rdfs:label "agricultural production activity"@en ;
    IAO:0000115 "Growing crops or raising livestock."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf icon:0001020 .

