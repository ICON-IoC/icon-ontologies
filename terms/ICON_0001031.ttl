@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0001031 a owl:Class ;
    rdfs:label "habitat enhancement activity"@en ;
    IAO:0000115 "Restoring or improving habitat, such as replanting, removing invasive plants or reconnecting floodplains."@en ;
    oboInOwl:hasExactSynonym "habitat restoration"@en,
        "restoration"@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subClassOf icon:0001020 .

