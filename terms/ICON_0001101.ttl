@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0001101 a owl:ObjectProperty ;
    rdfs:label "is org type of"@en ;
    IAO:0000115 "The reverse of has org type."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:range OBI:0000245 ;
    owl:inverseOf icon:0001100 .

