@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0001103 a owl:ObjectProperty ;
    rdfs:label "is member of"@en ;
    IAO:0000115 "An organization belongs to a coalition, association or partnership as a member while keeping its own identity. A kind of part of in the explorer."@en ;
    rdfs:domain OBI:0000245 ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:range OBI:0000245 ;
    rdfs:subPropertyOf BFO:0000050,
        OBI:0000846 ;
    owl:inverseOf icon:0001104 ;
    skos:closeMatch org:memberOf,
        schema:memberOf .

