@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0001106 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is partner of"@en ;
    IAO:0000115 "The reverse of has partner."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0001105 .

