@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0001107 a owl:ObjectProperty ;
    rdfs:label "is published by"@en ;
    IAO:0000115 "The organization responsible for making data or a publication available, when it is not the creator."@en ;
    rdfs:isDefinedBy iconbase:organizations.owl ;
    rdfs:range OBI:0000245 ;
    owl:inverseOf icon:0001108 ;
    skos:closeMatch dcterms:publisher,
        schema:publisher ;
    icon:0000001 "DataCite 4.5: publisher",
        "EML 2.2: dataset/publisher",
        "ISO 19115-1: CI_RoleCode publisher" .

