  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0002100">
    <obo:IAO_0000115 xml:lang="en">A person works for, serves on the board of, or is otherwise attached to an organization. The link may carry the person's title and its role type.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/people.owl"/>
    <rdfs:label xml:lang="en">is affiliated with</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon-ioc/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0002101"/>
    <skos:closeMatch rdf:resource="https://schema.org/affiliation"/>
  </rdf:Description>
