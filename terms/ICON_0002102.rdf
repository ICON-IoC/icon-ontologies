  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002102">
    <obo:IAO_0000115 xml:lang="en">The person to ask about an organization, project, place or data resource. The person's contact details are private.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">has contact</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/icon/ICON_0000100"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002103"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#contactPoint"/>
    <iconbase:ICON_0000001>DataCite 4.5: contributorType ContactPerson</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: dataset/contact</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: CI_RoleCode pointOfContact</iconbase:ICON_0000001>
  </rdf:Description>
</rdf:RDF>
