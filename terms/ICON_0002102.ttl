@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0002102 a owl:ObjectProperty ;
    rdfs:label "has contact"@en ;
    IAO:0000115 "The person to ask about an organization, project, place or data resource. The person's contact details are private."@en ;
    rdfs:isDefinedBy iconbase:people.owl ;
    rdfs:range NCBITaxon:9606 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0002103 ;
    skos:closeMatch dcat:contactPoint ;
    icon:0000001 "DataCite 4.5: contributorType ContactPerson",
        "EML 2.2: dataset/contact",
        "ISO 19115-1: CI_RoleCode pointOfContact" .

