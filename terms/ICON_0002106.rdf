  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0002106">
    <obo:IAO_0000115 xml:lang="en">An elected official holds the seat of the district: a member of the State Assembly or State Senate, a member of Congress, or a county supervisor. A U.S. senator represents the whole state (#1432).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The office and party are the link's role title, and the year the person took the seat is the link's start.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/people.owl"/>
    <rdfs:label xml:lang="en">represents</rdfs:label>
    <rdfs:range rdf:nodeID="cb68067f2b743e19efb21ee5d853c3161b0666d622a2f0455c63f429b69f182231"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0002107"/>
