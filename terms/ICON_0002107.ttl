@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0002107 a owl:ObjectProperty ;
    rdfs:label "is represented by"@en ;
    IAO:0000115 "The reverse of represents."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0010005 icon:0010003 ) ] ;
    rdfs:isDefinedBy iconbase:people.owl ;
    rdfs:range NCBITaxon:9606 ;
    owl:inverseOf icon:0002106 .

