@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0003000 a owl:Class ;
    rdfs:label "conservation project"@en ;
    IAO:0000115 "A bounded effort with a lead and usually partners and funders that restores, protects, acquires, studies, plans or manages something in a place, and ends when its work is done."@en ;
    rdfs:isDefinedBy iconbase:projects.owl ;
    rdfs:subClassOf icon:0000011 ;
    skos:closeMatch foaf:Project,
        schema:Project .

