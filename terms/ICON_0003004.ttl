@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0003004 a owl:Class ;
    rdfs:label "infrastructure project"@en ;
    IAO:0000115 "A project that builds, removes or rebuilds a structure, such as a fish ladder, a levee setback or a wildlife crossing."@en ;
    rdfs:isDefinedBy iconbase:projects.owl ;
    rdfs:subClassOf icon:0003000 .

