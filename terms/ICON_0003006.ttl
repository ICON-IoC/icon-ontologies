@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0003006 a owl:Class ;
    rdfs:label "management project"@en ;
    IAO:0000115 "A project that manages land, water or wildlife, such as grazing, burning or invasive species control."@en ;
    rdfs:isDefinedBy iconbase:projects.owl ;
    rdfs:subClassOf icon:0003000 .

