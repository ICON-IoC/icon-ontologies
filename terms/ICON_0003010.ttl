@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0003010 a owl:Class ;
    rdfs:label "compensatory mitigation project"@en ;
    IAO:0000115 "A project that restores, creates or preserves habitat to make up for habitat a permitted development destroys elsewhere."@en ;
    rdfs:isDefinedBy iconbase:projects.owl ;
    rdfs:subClassOf icon:0003000 .

