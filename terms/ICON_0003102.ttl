@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0003102 a owl:ObjectProperty ;
    rdfs:label "is part of program"@en ;
    IAO:0000115 "A project carried out within a program, as one grant within a grant program."@en ;
    rdfs:domain icon:0003000 ;
    rdfs:isDefinedBy iconbase:projects.owl ;
    rdfs:range icon:0004000 ;
    rdfs:subPropertyOf BFO:0000050 ;
    owl:inverseOf icon:0003103 .

