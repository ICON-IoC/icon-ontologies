@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0003104 a owl:ObjectProperty ;
    rdfs:label "tracked by"@en ;
    IAO:0000115 "The organization that keeps a project's or plan's record in a project tracker such as EcoAtlas, often the agency that permitted or funded it, without necessarily leading it. Keeping the record is not taking part in the work, so this is not a kind of is involved with."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0003000 icon:0007001 ) ] ;
    rdfs:isDefinedBy iconbase:projects.owl ;
    rdfs:range OBI:0000245 ;
    owl:inverseOf icon:0003105 .

