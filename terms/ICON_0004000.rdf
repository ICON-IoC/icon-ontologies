<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0004000">
    <obo:IAO_0000115 xml:lang="en">An ongoing arrangement, usually run by an agency, that funds, regulates, certifies, plans or carries out conservation work through many projects or participants, with no set end.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/programs.owl"/>
    <rdfs:label xml:lang="en">conservation program</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0000011"/>
  </rdf:Description>
</rdf:RDF>
