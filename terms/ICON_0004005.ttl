@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0004005 a owl:Class ;
    rdfs:label "habitat enhancement program"@en ;
    IAO:0000115 "A program that restores or improves habitat."@en ;
    oboInOwl:hasExactSynonym "restoration program"@en ;
    rdfs:isDefinedBy iconbase:programs.owl ;
    rdfs:subClassOf icon:0004000 .

