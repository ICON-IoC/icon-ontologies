@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0004100 a owl:ObjectProperty ;
    rdfs:label "has program type"@en ;
    IAO:0000115 "Links a program to one of the program type classes it belongs to. The explorer's way of stating the program's class."@en ;
    rdfs:domain icon:0004000 ;
    rdfs:isDefinedBy iconbase:programs.owl ;
    owl:inverseOf icon:0004101 .

