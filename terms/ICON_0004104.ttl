@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0004104 a owl:ObjectProperty ;
    rdfs:label "operates at"@en ;
    IAO:0000115 "A place where the program does its work, such as a river a restoration program works along, a groundwater basin a banking program recharges, or a camera array a research program runs."@en ;
    rdfs:domain icon:0004000 ;
    rdfs:isDefinedBy iconbase:programs.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0004105 .

