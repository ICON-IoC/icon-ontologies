@prefix ENVO: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0005033 a owl:Class ;
    rdfs:label "crop production site"@en ;
    IAO:0000115 "A farm, orchard, vineyard or field where crops are grown."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005005 ;
    skos:closeMatch ENVO:00000114 .

