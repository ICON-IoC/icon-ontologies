<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0005042">
    <obo:IAO_0000115 xml:lang="en">A research station or reserve that a university or agency runs for research and teaching, often with housing and labs, giving access to protected lands it may not own.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for UC Nature's field stations in national parks and forests and its reserves on private or leased land (#369).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/infrastructure.owl"/>
    <rdfs:label xml:lang="en">field station</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0005002"/>
  </rdf:Description>
</rdf:RDF>
