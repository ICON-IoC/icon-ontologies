@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0005052 a owl:Class ;
    rdfs:label "important bird area"@en ;
    IAO:0000115 "A site that BirdLife International's Important Bird Areas program, run in the United States by the National Audubon Society, identifies as essential for birds because it holds species of conservation concern, range-restricted species or large concentrations of birds, without itself being protected."@en ;
    rdfs:comment "Added for the grassland Important Bird Areas of California Partners in Flight's Grassland Bird Conservation Plan (#976)."@en ;
    rdfs:isDefinedBy iconbase:infrastructure.owl ;
    rdfs:subClassOf icon:0005002 .

