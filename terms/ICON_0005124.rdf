<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0005124">
    <obo:IAO_0000115 xml:lang="en">An area that the California Native Plant Society's Important Plant Areas Initiative identifies as among the most important places in the state for rare plants and rare vegetation types, without itself being protected. Example: a Tier 1 area of the Northwestern California ecoregion around the Mendocino pygmy forest, home to 37 California Rare Plant Rank 1B species.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added for the statewide draft Important Plant Areas that CNPS published for review in 2026 (#1210).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/infrastructure.owl"/>
    <rdfs:label xml:lang="en">important plant area</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0005002"/>
  </rdf:Description>
</rdf:RDF>
