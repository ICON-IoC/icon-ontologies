@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OMRSE: <http://purl.obolibrary.org/obo/OMRSE_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0006001 a owl:Class ;
    rdfs:label "agreement"@en ;
    IAO:0000115 "A guideline or mandate that two or more parties sign, such as a memorandum of understanding, a settlement or a habitat conservation plan's implementing agreement."@en ;
    rdfs:isDefinedBy iconbase:mandates.owl ;
    rdfs:subClassOf icon:0006000 ;
    skos:closeMatch OMRSE:00000089 .

