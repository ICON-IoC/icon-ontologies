<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0006002">
    <obo:IAO_0000115 xml:lang="en">A guideline or mandate that sets the practices land, products or operations must meet to be certified, such as a sustainable farming or forestry standard.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/mandates.owl"/>
    <rdfs:label xml:lang="en">certification standard</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0006000"/>
  </rdf:Description>
</rdf:RDF>
