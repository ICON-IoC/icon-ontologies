@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0006003 a owl:Class ;
    rdfs:label "executive order"@en ;
    IAO:0000115 "A guideline or mandate that a president or governor issues to direct government agencies."@en ;
