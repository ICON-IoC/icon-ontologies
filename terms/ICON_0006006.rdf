  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0006006">
    <obo:IAO_0000115 xml:lang="en">A guideline or mandate that an agency adopts under authority a statute gives it, with the force of law, as in the California Code of Regulations.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/mandates.owl"/>
    <rdfs:label xml:lang="en">regulation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0006000"/>
  </rdf:Description>
</rdf:RDF>
