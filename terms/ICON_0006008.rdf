<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0006008">
    <obo:IAO_0000115 xml:lang="en">A guideline or mandate that a court issues in a case, such as a writ of mandate or an injunction, directing a party, often a government agency, to act or to stop acting. It binds the parties named in it. Example: the 2025 writ of mandate in California Chaparral Institute v. Board of Forestry and Fire Protection, which limits the California Vegetation Treatment Program in chaparral and coastal sage scrub.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/mandates.owl"/>
    <rdfs:label xml:lang="en">court order</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0006000"/>
  </rdf:Description>
</rdf:RDF>
