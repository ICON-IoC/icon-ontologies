  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0006015">
    <obo:IAO_0000115 xml:lang="en">An agreement among national governments, such as a treaty or a decision of the parties to a convention. Example: the Kunming-Montreal Global Biodiversity Framework (2022), adopted under the Convention on Biological Diversity.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
