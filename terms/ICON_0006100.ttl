@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0006100 a owl:ObjectProperty ;
    rdfs:label "has instrument type"@en ;
    IAO:0000115 "Links a guideline or mandate to one of the instrument type classes it belongs to. The explorer's way of stating its class."@en ;
    rdfs:domain icon:0006000 ;
    rdfs:isDefinedBy iconbase:mandates.owl ;
    owl:inverseOf icon:0006101 .

