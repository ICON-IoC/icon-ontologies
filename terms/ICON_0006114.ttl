@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0006114 a owl:ObjectProperty ;
    rdfs:label "is supported by"@en ;
    IAO:0000115 "An organization's work rests on a guideline or mandate, as a program on the statute that authorizes it."@en ;
    rdfs:isDefinedBy iconbase:mandates.owl ;
    owl:inverseOf icon:0006115 .

