  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0006121">
    <obo:IAO_0000115 xml:lang="en">An organization sponsored a bill or ballot measure: it brought the proposal to the legislator who carried it, or campaigned for the measure, and backed it to passage.</obo:IAO_0000115>
