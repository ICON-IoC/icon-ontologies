@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0006123 a owl:ObjectProperty ;
    rdfs:label "is authorized under"@en ;
    IAO:0000115 "A project went ahead under a permit, order, biological opinion or exemption that approved its work, such as a restoration project covered by a programmatic biological opinion or a nationwide permit."@en ;
    rdfs:domain icon:0003000 ;
    rdfs:isDefinedBy iconbase:mandates.owl ;
    rdfs:range icon:0006000 ;
    owl:inverseOf icon:0006124 .

