@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007012 a owl:Class ;
    rdfs:label "open space vision plan"@en ;
    IAO:0000115 "A conservation plan for the lands of a regional open space or park district and the region around them, written by the district with a community advisory committee and public engagement, that sets long-term themes and goals for conservation, public access, education and working lands and ranks place-based priority actions, often as the basis for a funding measure."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

