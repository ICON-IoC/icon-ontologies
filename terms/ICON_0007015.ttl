@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007015 a owl:Class ;
    rdfs:label "statewide conservation strategy"@en ;
    IAO:0000115 "A conservation plan for a whole state, issued by its government to meet a statewide area-based conservation goal such as conserving 30 percent of its lands and coastal waters by 2030, that defines what counts as conserved, sets key objectives, and lays out pathways of strategic actions for state agencies working with tribes, federal and local governments and other partners, with progress tracked in public data and periodic reports."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

