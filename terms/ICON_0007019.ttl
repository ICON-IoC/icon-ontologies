@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007019 a owl:Class ;
    rdfs:label "interagency shared strategy"@en ;
    IAO:0000115 "A conservation plan for one statewide land management need, such as reforestation after wildfire, written by state and federal agencies with nonprofit and university partners under an interagency body such as California's Wildfire and Forest Resilience Task Force, that measures the need and the progress against it, proposes how to prioritize the work, and sets goals with key actions assigned to named agencies and partnerships. It informs the body's action plan and binds no agency."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

