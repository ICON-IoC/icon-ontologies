@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007022 a owl:Class ;
    rdfs:label "fishery management plan"@en ;
    IAO:0000115 "A conservation plan that a regional fishery management council prepares under Section 303 of the Magnuson-Stevens Fishery Conservation and Management Act for a fishery in federal waters, that names the managed stocks, sets goals and objectives, defines overfishing and optimum yield, describes and identifies essential fish habitat, and sets the framework for harvest limits, allocation and other management measures. The Secretary of Commerce approves it and its amendments, and NOAA Fisheries implements it through federal regulations that bind those who fish."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

