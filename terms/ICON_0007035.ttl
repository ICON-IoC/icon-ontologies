@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007035 a owl:Class ;
    rdfs:label "continental bird conservation plan"@en ;
    IAO:0000115 "A conservation plan for one group of birds across North America, accepted by the national governments of Canada, the United States and Mexico or adopted by a continental partnership, that sets continental population, habitat and supporter goals and objectives and recommends how its governance bodies, science teams and partners should pursue them. Regional Migratory Bird Joint Ventures step its continental objectives down to their regions in joint venture implementation plans. It binds no one. Example: the North American Waterfowl Management Plan (1986; 2024 Update)."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

