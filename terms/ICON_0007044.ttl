@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007044 a owl:Class ;
    rdfs:label "public works plan"@en ;
    IAO:0000115 "A long-range plan under the California Coastal Act (Public Resources Code 30605) in which a public agency lays out the parks, trails, access ways, and facilities it intends to build in the coastal zone, so that the Coastal Commission can certify the whole program at once instead of permitting each project. Example: the Malibu Parks Public Access Enhancement Plan, adopted in 2010 by the Mountains Recreation and Conservation Authority and the Santa Monica Mountains Conservancy."@en ;
    rdfs:comment "Added for the Mountains Recreation and Conservation Authority's Malibu public works plans (#1177)."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

