@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007102 a owl:ObjectProperty ;
    rdfs:label "issued by"@en ;
    IAO:0000115 "The agency or organization that issued the plan. A kind of was issued by."@en ;
    rdfs:domain icon:0007001 ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:range OBI:0000245 ;
    rdfs:subPropertyOf icon:0000100,
        icon:0006113 .

