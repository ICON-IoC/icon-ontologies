@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007103 a owl:ObjectProperty ;
    rdfs:label "is objective of"@en ;
    IAO:0000115 "The objective belongs to the plan."@en ;
    rdfs:domain icon:0007002 ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:range icon:0007001 ;
    rdfs:subPropertyOf BFO:0000050 ;
    owl:inverseOf icon:0007104 .

