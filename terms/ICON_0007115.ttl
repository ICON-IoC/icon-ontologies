@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007115 a owl:ObjectProperty ;
    rdfs:label "covers site"@en ;
    IAO:0000115 "A place within the plan's scope."@en ;
    rdfs:domain icon:0007001 ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:range icon:0005000 ;
    owl:inverseOf icon:0007116 .

