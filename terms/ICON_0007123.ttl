@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0007123 a owl:Class ;
    rdfs:label "heritage area management plan"@en ;
    IAO:0000115 "The plan that the local coordinating entity of a National Heritage Area writes with partners and the public, and the Secretary of the Interior approves, that sets the area's interpretive themes, goals, and strategies for preserving, interpreting, and promoting its natural, cultural, and historic resources. Example: the Sacramento-San Joaquin Delta National Heritage Area Management Plan, approved in January 2025."@en ;
    rdfs:comment "Added for the Sacramento-San Joaquin Delta National Heritage Area Management Plan (#1677)."@en ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:subClassOf icon:0007001 .

