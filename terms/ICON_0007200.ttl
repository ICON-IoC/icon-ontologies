@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0007200 a owl:DatatypeProperty ;
    rdfs:label "plan status"@en ;
    IAO:0000115 "Where the plan stands: draft, final, revised, under review."@en ;
    rdfs:domain icon:0007001 ;
    rdfs:isDefinedBy iconbase:plans.owl ;
    rdfs:range xsd:string .

