  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008010">
    <obo:IAO_0000115 xml:lang="en">The form data comes in, from the Terms sheet's dataset types; formats are data types, listed with the kinds of data (#304). DCAT records format on each downloadable distribution; the graph keeps it on the data until a resource has more than one form worth recording.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">data format</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0008080"/>
    <iconbase:ICON_0000001>DataCite 4.5: format</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>EML 2.2: physical/dataFormat</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>ISO 19115-1: MD_Format</iconbase:ICON_0000001>
  </rdf:Description>
</rdf:RDF>
