>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0008110">
    <obo:IAO_0000115 xml:lang="en">A standard or guideline a data resource, tool, plan or plan action follows, recorded as a guideline: a data standard such as Darwin Core or the FGDC metadata standard, the policy whose required analyses a tool carries out, the agency guide a plan was written to, or the guidelines an action says to follow.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/data.owl"/>
    <rdfs:label xml:lang="en">conforms to</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon-ioc/ICON_0006000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0008111"/>
    <skos:closeMatch rdf:resource="http://purl.org/dc/terms/conformsTo"/>
    <iconbase:ICON_0000001>ISO 19115-1: DQ_DomainConsistency/result/specification</iconbase:ICON_0000001>
  </rdf:Description>
</rdf:RDF>
