    <rdfs:label xml:lang="en">coverage start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#startDate"/>
    <iconbase:ICON_0000001>DataCite 4.5: date dateType Coverage</iconbase:ICON_0000001>
