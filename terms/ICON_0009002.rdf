  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0009002">
    <obo:IAO_0000115 xml:lang="en">A report an agency, organization or research group issues itself on a study, a monitoring program, an assessment or a project's results, usually in a numbered series. It may or may not have been reviewed.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/publications.owl"/>
    <rdfs:label xml:lang="en">technical report</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000088"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0009000"/>
    <skos:closeMatch rdf:resource="http://purl.org/ontology/bibo/Report"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/TechnicalReport"/>
    <skos:closeMatch rdf:resource="https://schema.org/Report"/>
    <iconbase:ICON_0000001>Crossref: report</iconbase:ICON_0000001>
    <iconbase:ICON_0000001>DataCite 4.5: resourceTypeGeneral Report</iconbase:ICON_0000001>
