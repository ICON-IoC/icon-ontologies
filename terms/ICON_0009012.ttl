@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0009012 a owl:NamedIndividual,
        icon:0009010 ;
    rdfs:label "free to read publication"@en ;
    IAO:0000115 "Free to read on the publisher's site but without an open license."@en ;
    rdfs:isDefinedBy iconbase:publications.owl .

