@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0009100 a owl:ObjectProperty ;
    rdfs:label "has publication type"@en ;
    IAO:0000115 "Links a paper or report to the class it belongs to: peer-reviewed paper or technical report. The explorer's way of stating its class."@en ;
    rdfs:domain icon:0009000 ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    owl:inverseOf icon:0009101 .

