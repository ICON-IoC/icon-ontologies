@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0009102 a owl:ObjectProperty ;
    rdfs:label "authored by"@en ;
    IAO:0000115 "A person or organization that wrote the work. The full author list as printed is the authors attribute, since most authors have no record of their own."@en ;
    rdfs:domain icon:0009000 ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    rdfs:range icon:0000010 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0009103 ;
    skos:closeMatch dcterms:creator,
        schema:author ;
    icon:0000001 "Crossref: contributors/person_name contributor_role author",
        "DataCite 4.5: creator" .

