@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0009103 a owl:ObjectProperty ;
    rdfs:label "authored"@en ;
    IAO:0000115 "The reverse of authored by."@en ;
