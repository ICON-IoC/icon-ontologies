@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0009104 a owl:ObjectProperty ;
    rdfs:label "commissioned by"@en ;
    IAO:0000115 "The organization a technical report was prepared for, when someone else wrote it, as a consultant's report for an agency."@en ;
    rdfs:domain icon:0009000 ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    rdfs:range OBI:0000245 ;
    rdfs:subPropertyOf icon:0000100 ;
    owl:inverseOf icon:0009105 ;
    skos:closeMatch schema:sponsor ;
    icon:0000001 "DataCite 4.5: contributorType Sponsor" .

