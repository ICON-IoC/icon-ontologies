@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0009107 a owl:ObjectProperty ;
    rdfs:label "is described by"@en ;
    IAO:0000115 "The reverse of describes."@en ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    rdfs:range icon:0009000 ;
    owl:inverseOf icon:0009106 .

