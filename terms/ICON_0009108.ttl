@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0009108 a owl:ObjectProperty ;
    rdfs:label "uses data from"@en ;
    IAO:0000115 "The work's analysis, or the tool, draws on this dataset, database or repository. For a tool, the workbook's inDataset column."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0009000 icon:0013000 ) ] ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    rdfs:range icon:0008000 ;
    owl:inverseOf icon:0009109 ;
    skos:closeMatch cito:usesDataFrom,
        schema:isBasedOn ;
    icon:0000001 "DataCite 4.5: relatedIdentifier relationType References" .

