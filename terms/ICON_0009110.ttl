@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0009110 a owl:ObjectProperty ;
    rdfs:label "cites"@en ;
    IAO:0000115 "The work cites another paper or report in the graph."@en ;
    rdfs:domain icon:0009000 ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    rdfs:range icon:0009000 ;
    owl:inverseOf icon:0009111 ;
    skos:closeMatch schema:citation ;
    skos:exactMatch cito:cites ;
    icon:0000001 "Crossref: citation_list",
        "DataCite 4.5: relatedIdentifier relationType Cites" .

