@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0009200 a owl:DatatypeProperty ;
    rdfs:label "authors"@en ;
    IAO:0000115 "The author list as printed on the work: Smith, J., Lee, K. and Ortiz, M. Public bibliographic information, not contact details."@en ;
    rdfs:domain icon:0009000 ;
    rdfs:isDefinedBy iconbase:publications.owl ;
    rdfs:range xsd:string ;
    skos:closeMatch bibo:authorList ;
    icon:0000001 "Crossref: contributors",
        "DataCite 4.5: creator/creatorName" .

