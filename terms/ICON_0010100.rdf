  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0010100">
    <obo:IAO_0000115 xml:lang="en">The record works in, covers or is about the area. A county cell of All in a workbook links the record to statewide instead.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The chains are two of the explorer's rules. Place roll-up: working on a place located in an area means operating in that area. Place containment: operating in an area means operating in every area that contains it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/places.owl"/>
    <rdfs:label xml:lang="en">operates in</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0010101"/>
    <owl:propertyChainAxiom rdf:nodeID="cb12c4d276cf1b0cb0fb457487bfd958251a071b7b6170248299325afed3306bdc1"/>
    <owl:propertyChainAxiom rdf:nodeID="cb175449671035b2e016d54fe3428f9341dc9921c0aafc5812951aa789d9bf22d30"/>
