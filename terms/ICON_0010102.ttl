@prefix GEO: <http://purl.obolibrary.org/obo/GEO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0010102 a owl:ObjectProperty ;
    rdfs:label "applies in"@en ;
    IAO:0000115 "A guideline, mandate or plan has force or scope in the area."@en ;
    rdfs:isDefinedBy iconbase:places.owl ;
    owl:inverseOf icon:0010103 ;
    skos:closeMatch GEO:000000336 .

