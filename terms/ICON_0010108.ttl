@prefix ENVO: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0010108 a owl:ObjectProperty ;
    rdfs:label "in ecoregion"@en ;
    IAO:0000115 "The record works in, covers or lies in the ecoregion section."@en ;
    rdfs:isDefinedBy iconbase:places.owl ;
    rdfs:range ENVO:01000276 ;
    owl:inverseOf icon:0010109 ;
    skos:closeMatch dcterms:spatial .

