  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0011000">
    <obo:IAO_0000115 xml:lang="en">A species or a group of species that records concern, identified by its NatureServe element where it has one. Groups (salmonids, bats) are taxa at a higher rank or informal groupings of them.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/biodiversity.owl"/>
    <rdfs:label xml:lang="en">taxon</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000059"/>
    <skos:closeMatch rdf:resource="http://rs.tdwg.org/dwc/terms/Taxon"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/scientificName"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/taxonID"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/vernacularName"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011200"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011201"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011202"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon/ICON_0011203"/>
