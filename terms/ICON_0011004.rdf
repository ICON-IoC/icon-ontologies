<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:iconbase="https://w3id.org/icon-ioc/"
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0011004">
    <obo:IAO_0000115 xml:lang="en">A unit of vegetation: an alliance of the Manual of California Vegetation, as CDFW's California Natural Communities List names it (such as Valley oak woodland and forest, or Fremont's goldfields - Downingia vernal pools), or a group, macrogroup or division of the US National Vegetation Classification above it (#1409).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Finer than a CWHR habitat type. An alliance has its USNVC group as a broader habitat type, and the CWHR type CNPS places it in when there is one; where CNPS names several, it is related to each.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/biodiversity.owl"/>
    <rdfs:label xml:lang="en">vegetation type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
    <iconbase:ICON_0000002 rdf:resource="http://rs.tdwg.org/dwc/terms/scientificName"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0011210"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0011211"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0011212"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0011213"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0011214"/>
    <iconbase:ICON_0000002 rdf:resource="https://w3id.org/icon-ioc/ICON_0011215"/>
  </rdf:Description>
</rdf:RDF>
