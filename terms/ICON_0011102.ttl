@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0011102 a owl:ObjectProperty ;
    rdfs:label "has habitat type"@en ;
    IAO:0000115 "A CWHR habitat type (#169), vegetation type (#1409) or coastal and marine habitat type (#1410) the record covers, works in or affects."@en ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( icon:0011001 icon:0011004 icon:0011005 ) ] ;
    owl:inverseOf icon:0011103 ;
    owl:propertyChainAxiom ( icon:0011102 icon:0011108 ) ;
    skos:closeMatch dcterms:subject .

