@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0011103 a owl:ObjectProperty ;
    rdfs:label "is habitat type of"@en ;
    IAO:0000115 "The reverse of has habitat type."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0011001 icon:0011004 icon:0011005 ) ] ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    owl:inverseOf icon:0011102 .

