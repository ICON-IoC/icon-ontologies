@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0011104 a owl:ObjectProperty ;
    rdfs:label "has invasive rating"@en ;
    IAO:0000115 "The taxon is invasive in California, or at risk of becoming so, with this Cal-IPC rating (#410) or CDFW listing (#435)."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range icon:0011002 ;
    owl:inverseOf icon:0011105 .

