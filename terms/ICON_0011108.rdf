  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0011108">
    <obo:IAO_0000115 xml:lang="en">Links a habitat or vegetation type to a broader one that contains it: an MCV alliance to its USNVC group, a group to its macrogroup, a CMECS unit to the unit above it, a GET functional group to its biome and a biome to its realm, and an alliance or CMECS unit to the one CWHR habitat type it falls in. A record that has the narrower type has the broader one too (#1409, #1410, #1411).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="cb135ada270e98d863f9bcd09b4fb4e195f14378b988de93191d0dc70197c8fdd57"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/biodiversity.owl"/>
    <rdfs:label xml:lang="en">has broader habitat type</rdfs:label>
    <rdfs:range rdf:nodeID="cb19807d76649daefb9636ad4b3a4bb66847897b225007ea745c25718264788dfba"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon-ioc/ICON_0011109"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
  </rdf:Description>
</rdf:RDF>
