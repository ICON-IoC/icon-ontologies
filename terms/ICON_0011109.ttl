@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0011109 a owl:ObjectProperty ;
    rdfs:label "has narrower habitat type"@en ;
    IAO:0000115 "The reverse of has broader habitat type."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0011001 icon:0011004 icon:0011005 icon:0011006 ) ] ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( icon:0011001 icon:0011004 icon:0011005 icon:0011006 ) ] ;
    owl:inverseOf icon:0011108 ;
    skos:exactMatch skos:narrower .

