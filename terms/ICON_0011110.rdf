  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0011110">
    <obo:IAO_0000115 xml:lang="en">Links an MCV alliance or CMECS unit to each CWHR habitat type it may fall in, when there is more than one: a stand of it falls within one of them, but not always the same one. Nothing passes along it (#1409, #1410).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:nodeID="cb156bd8ce5eedcf34028466f0150daa60dc807366fc64b3240eb8c7fe7918a28c5"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/biodiversity.owl"/>
    <rdfs:label xml:lang="en">is related to habitat type</rdfs:label>
