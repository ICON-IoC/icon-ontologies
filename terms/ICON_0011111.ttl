@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0011111 a owl:ObjectProperty ;
    rdfs:label "has IUCN ecosystem group"@en ;
    IAO:0000115 "Links a CWHR, MCV or CMECS habitat type to the IUCN GET ecosystem functional groups it falls in, or to the biome or realm when it spans several of their groups. Mapped by hand in reference/get-crosswalk.csv at the broadest unit where the match holds and stated on every unit below it. Nothing passes along it: records are not tagged with GET (#1411)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0011001 icon:0011004 icon:0011005 ) ] ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range icon:0011006 ;
    owl:inverseOf icon:0011112 ;
    skos:exactMatch skos:broadMatch .

