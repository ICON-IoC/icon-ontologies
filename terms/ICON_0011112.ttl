@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0011112 a owl:ObjectProperty ;
    rdfs:label "is IUCN ecosystem group of"@en ;
    IAO:0000115 "The reverse of has IUCN ecosystem group."@en ;
    rdfs:domain icon:0011006 ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( icon:0011001 icon:0011004 icon:0011005 ) ] ;
    owl:inverseOf icon:0011111 ;
    skos:exactMatch skos:narrowMatch .

