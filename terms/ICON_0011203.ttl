@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0011203 a owl:DatatypeProperty ;
    rdfs:label "group level"@en ;
    IAO:0000115 "For a group, what defines it: NatureServe's informal taxonomy, or a rank of its scientific taxonomy (kingdom, phylum, class, order, family, subfamily, genus)."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range xsd:string .

