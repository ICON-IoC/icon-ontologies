@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0011204 a owl:DatatypeProperty ;
    rdfs:label "group value"@en ;
    IAO:0000115 "For a group, the name at its group level, such as Salmoninae for a subfamily group."@en ;
    rdfs:domain icon:0011000 ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range xsd:string .

