icon:0011205 a owl:DatatypeProperty ;
    rdfs:label "genera"@en ;
    IAO:0000115 "For a subfamily group, which NatureServe cannot search by rank, the genera it spans, separated by semicolons: Oncorhynchus; Salmo; Salvelinus."@en ;
