@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0011212 a owl:DatatypeProperty ;
    rdfs:label "life form"@en ;
    IAO:0000115 "The alliance's primary life form on the Natural Communities List: Tree, Shrub, Herb or Non-vascular."@en ;
