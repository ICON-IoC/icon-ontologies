icon:0011220 a owl:DatatypeProperty ;
    rdfs:label "CMECS classification level"@en ;
    IAO:0000115 "Where the CMECS unit sits: a System, Subsystem or Tidal Zone of the Aquatic Setting, or a Biotic Setting, Biotic Class, Biotic Subclass or Biotic Group of the Biotic Component."@en ;
