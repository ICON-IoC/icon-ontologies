@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0011222 a owl:DatatypeProperty ;
    rdfs:label "CMECS ID"@en ;
    IAO:0000115 "The unit's permanent identifier in the CMECS Catalog, such as CMECS_00000721; https://w3id.org/CMECS/ followed by it is the unit's IRI."@en ;
    rdfs:domain icon:0011005 ;
    rdfs:isDefinedBy iconbase:biodiversity.owl ;
    rdfs:range xsd:string ;
    skos:closeMatch dcterms:identifier .

