  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0011231">
    <obo:IAO_0000115 xml:lang="en">The unit's code in the IUCN Global Ecosystem Typology: a realm's letters (T, or MT for a transitional realm), a biome's (T4) or a functional group's (T4.4).</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icon-ioc/ICON_0011006"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/biodiversity.owl"/>
    <rdfs:label xml:lang="en">GET code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
  </rdf:Description>
</rdf:RDF>
