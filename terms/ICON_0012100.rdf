  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0012100">
    <obo:IAO_0000115 xml:lang="en">The record responds to, studies or bears on the issue. An organization that funds, leads, administers or manages work addressing an issue addresses it too.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The chains are the explorer's issue roll-up rules: from work to who backs it, and from a component issue to its integrated issues.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/issues.owl"/>
    <rdfs:label xml:lang="en">addresses issue</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icon/ICON_0012000"/>
    <owl:inverseOf rdf:resource="https://w3id.org/icon/ICON_0012101"/>
    <owl:propertyChainAxiom rdf:nodeID="cb10dd88153388673b6c66adc464236046d37a7c2c9d835fea03856aeef525a6b7a"/>
