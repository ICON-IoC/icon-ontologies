  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0013003">
    <obo:IAO_0000115 xml:lang="en">A web page that tracks a set of indicators in charts and maps, often over time. Example: California Carbon Dashboard.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/tools.owl"/>
    <rdfs:label xml:lang="en">dashboard</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000594"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0013000"/>
