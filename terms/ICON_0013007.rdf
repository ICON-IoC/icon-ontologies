  <rdf:Description rdf:about="https://w3id.org/icon/ICON_0013007">
    <obo:IAO_0000115 xml:lang="en">A guide that leads its user, step by step or by comparing pictures, to the name of a plant or animal they have found. Example: Berkeley BioKeys.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon/tools.owl"/>
    <rdfs:label xml:lang="en">identification key</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon/ICON_0013000"/>
  </rdf:Description>
</rdf:RDF>
