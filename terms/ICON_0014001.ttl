@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0014001 a owl:Class ;
    rdfs:label "target"@en ;
    IAO:0000115 "The amount of an indicator that an objective, plan, program or guideline or mandate sets out to reach, by a year where it gives one: restore 5,000 to 7,000 acres of tidal marsh within 30 years. A range keeps its low and high values; a milestone is another target on the same indicator with an earlier year."@en ;
    rdfs:isDefinedBy iconbase:outcomes.owl ;
    rdfs:subClassOf IAO:0000033 ;
    icon:0000001 "Conservation Standards 4.0: objective" ;
    icon:0000002 icon:0014200,
        icon:0014201,
        icon:0014202,
        icon:0014203,
        icon:0014204,
        icon:0014208 .

