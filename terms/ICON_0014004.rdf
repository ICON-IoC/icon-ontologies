<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:obo="http://purl.obolibrary.org/obo/"
   xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/icon-ioc/ICON_0014004">
    <obo:IAO_0000115 xml:lang="en">An outcome recorded as delivered, by a report, a monitoring survey or an inventory such as CPAD, or by a project tracker that lists the work as completed.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym xml:lang="en">achieved outcome</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icon-ioc/outcomes.owl"/>
    <rdfs:label xml:lang="en">measured outcome</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icon-ioc/ICON_0014002"/>
  </rdf:Description>
</rdf:RDF>
