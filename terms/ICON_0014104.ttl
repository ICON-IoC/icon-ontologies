@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix icon: <https://w3id.org/icon/ICON_> .
@prefix iconbase: <https://w3id.org/icon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

icon:0014104 a owl:ObjectProperty ;
    rdfs:label "has outcome"@en ;
    IAO:0000115 "A project, program or place delivers the outcome, expected or measured (#959). The explorer shows a record's outcomes in its panel rather than as links."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0003000 icon:0004000 icon:0005000 ) ] ;
    rdfs:isDefinedBy iconbase:outcomes.owl ;
    rdfs:range icon:0014002 ;
    owl:inverseOf icon:0014105 ;
    skos:closeMatch OBI:0000299 ;
    icon:0000001 "Conservation Standards 4.0: result" .

