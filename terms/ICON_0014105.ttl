@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0014105 a owl:ObjectProperty ;
    rdfs:label "is outcome of"@en ;
    IAO:0000115 "The reverse of has outcome."@en ;
    rdfs:domain icon:0014002 ;
    rdfs:isDefinedBy iconbase:outcomes.owl ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( icon:0003000 icon:0004000 icon:0005000 ) ] ;
    owl:inverseOf icon:0014104 .

