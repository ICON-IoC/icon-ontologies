@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icon:0014106 a owl:ObjectProperty ;
    rdfs:label "has target"@en ;
    IAO:0000115 "An objective, action, plan, program or guideline or mandate sets the target (#959). The explorer shows a record's targets, with progress toward them, in its panel rather than as links."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( icon:0004000 icon:0006000 icon:0007001 icon:0007002 icon:0007003 ) ] ;
    rdfs:isDefinedBy iconbase:outcomes.owl ;
    rdfs:range icon:0014001 ;
    owl:inverseOf icon:0014107 ;
    icon:0000001 "Conservation Standards 4.0: objective" .

