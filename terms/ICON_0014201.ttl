@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix icon: <https://w3id.org/icon-ioc/ICON_> .
@prefix iconbase: <https://w3id.org/icon-ioc/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

icon:0014201 a owl:DatatypeProperty ;
    rdfs:label "target high value"@en ;
    IAO:0000115 "The high end of a target given as a range."@en ;
    rdfs:domain icon:0014001 ;
    rdfs:isDefinedBy iconbase:outcomes.owl ;
    rdfs:range xsd:decimal .

